<!DOCTYPE html>
<html lang="fr">
<head>
    <title>{% block title %}Galerie - Rock Fever{% endblock %}</title>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"/>
    <link type="text/css" rel="stylesheet" href="{{ asset('/css/base.css') }}"/>
    <link  href="{{ asset('/css/style.css') }}" rel="stylesheet"/>
    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>
<body class="admin">
<nav class="koamaru" aria-label="Galerie">
    <div class="nav-wrapper container">
        <a href="{{ path('home') }}" class="brand-logo">Galerie</a>
    </div>
</nav>
<main>
    <div class="container">
        {% include 'flash.twig' %}
    </div>
    {% block body %}
    {% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/clipboard@2.0.11/dist/clipboard.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js"></script>
{#- script.js copies the URLs with clipboard.js and lays the images out with Masonry #}
<script type="text/javascript" src="{{ asset('/js/script.js') }}"></script>
</body>
</html>