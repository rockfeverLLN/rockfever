<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MKKLSTRX4W"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-MKKLSTRX4W');
    </script>
    <title>{% block title %}Rock Fever{% endblock %}</title>
    <meta name="description" content="{% block description %}Rock Fever, le rock à Louvain-la-Neuve : prochain événement, inscriptions et propositions de musique.{% endblock %}"/>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
    <link rel="preload" href="{{ __DIR__ }}/fonts/material-icons.woff2" as="font" type="font/woff2" crossorigin/>
    {% block head %}{% endblock %}
    {# Rules the public pages need for the first paint (built by bin/critical-css.php), the full stylesheets load in the background #}
    <style>{{ source('critical.css') }}</style>
    {# Icon font loaded without blocking the first paint #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@2.1.19/css/materialdesignicons.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@2.1.19/css/materialdesignicons.min.css"></noscript>
    <link rel="preload" href="{{ __DIR__ }}/css/materialize.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <link rel="preload" href="{{ __DIR__ }}/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript>
        <link rel="stylesheet" href="{{ __DIR__ }}/css/materialize.min.css"/>
        <link rel="stylesheet" href="{{ __DIR__ }}/css/style.css"/>
    </noscript>
    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
</head>

<body class="{% block bodyColor %}{% endblock %}">
    {% include "topbar.twig" %}

    <main>
    {% block body %}
    {% endblock %}
    </main>

    {% include "footer.twig" %}

    <script type="text/javascript" src="{{ __DIR__ }}/js/jquery.min.js"></script>
    <script type="text/javascript" src="{{ __DIR__ }}/js/materialize.min.js"></script>
    <script type="text/javascript" src="{{ __DIR__ }}/js/script.js"></script>
</body>
</html>
