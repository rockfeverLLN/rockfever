<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- Google tag (gtag.js) and the footer's Facebook frame, loaded once the page has finished loading so they don't compete with it -->
    <script>
        window.addEventListener('load', function () {
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-MKKLSTRX4W';
            document.head.appendChild(tag);
            document.querySelectorAll('iframe[data-src]').forEach(function (frame) {
                frame.src = frame.dataset.src;
            });
        });
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        {#- No consent banner: Analytics runs in cookieless mode (Consent Mode denied), so nothing is stored on the visitor's device #}
        gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
        });
        gtag('js', new Date());

        gtag('config', 'G-MKKLSTRX4W');
    </script>
    <title>{% block title %}Rock Fever{% endblock %}</title>
    <meta name="description" content="{% block description %}Rock Fever, le rock à Louvain-la-Neuve : prochain événement, inscriptions et propositions de musique.{% endblock %}"/>
    {#- Public pages set their path so duplicates (/accueil, /home, ?query) point search engines to one URL #}
    {%- if block('canonical_path') is defined %}
    <link rel="canonical" href="https://rockfever.be{{ block('canonical_path') }}"/>
    {%- endif %}

    <link rel="preload" href="{{ __DIR__ }}/fonts/material-icons.woff2?v=4c26ce59" as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href="{{ __DIR__ }}/fonts/inter.woff2?v=8e433c05" as="font" type="font/woff2" crossorigin/>
    {% block head %}{% endblock %}
    {# Rules the public pages need for the first paint (built by bin/critical-css.php), the full stylesheets load in the background #}
    <style>{{ source('critical.css') }}</style>
    <link rel="preload" href="{{ __DIR__ }}/css/materialize.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <link rel="preload" href="{{ __DIR__ }}/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript>
        <link rel="stylesheet" href="{{ __DIR__ }}/css/materialize.min.css"/>
        <link rel="stylesheet" href="{{ __DIR__ }}/css/style.css"/>
    </noscript>
    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
</head>

{#- "site" scopes the public pages' font, menu and footer styles: the admin uses the same style.css #}
<body class="site {% block bodyColor %}{% endblock %}">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {% include "topbar.twig" %}

    <main id="contenu" tabindex="-1">
    {% block body %}
    {% endblock %}
    </main>

    {% include "footer.twig" %}

    <script type="text/javascript" src="{{ __DIR__ }}/js/jquery.min.js" defer></script>
    <script type="text/javascript" src="{{ __DIR__ }}/js/materialize.min.js" defer></script>
    <script type="text/javascript" src="{{ __DIR__ }}/js/script.js" defer></script>
</body>
</html>
