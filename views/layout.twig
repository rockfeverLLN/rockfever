<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- The site's scripts and the Google tag (gtag.js) are only needed once the page is shown: they load after its
         first paint, so that on a slow connection they don't hold it back -->
    <script>
        (function () {
            var loaded = false;
            function loadScripts() {
                if (loaded) {
                    return;
                }
                loaded = true;
                [
                    '{{ asset('/js/jquery.min.js') }}',
                    '{{ asset('/js/materialize.min.js') }}',
                    '{{ asset('/js/script.js') }}',
                    'https://www.googletagmanager.com/gtag/js?id=G-MKKLSTRX4W'
                ].forEach(function (src) {
                    var tag = document.createElement('script');
                    // Run them in this order, like defer did: jQuery, then Materialize, then the site's script
                    tag.async = false;
                    tag.src = src;
                    document.head.appendChild(tag);
                });
            }
            // The load event often comes before the first paint: wait for the browser to report that paint
            window.addEventListener('load', function () {
                try {
                    new PerformanceObserver(function () {
                        setTimeout(loadScripts);
                    }).observe({type: 'paint', buffered: true});
                } catch (e) {
                    // Browsers that don't report paints
                }
                setTimeout(loadScripts, 1000);
            });
        })();
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        {#- No consent banner: Analytics runs in cookieless mode (Consent Mode denied), so nothing is stored on the visitor's device #}
        gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
        });
        gtag('js', new Date());

        gtag('config', 'G-MKKLSTRX4W');
    </script>
    <title>{% block title %}Rock Fever{% endblock %}</title>
    <meta name="description" content="{% block description %}Rock Fever, le rock à Louvain-la-Neuve : prochain événement, inscriptions et propositions de musique.{% endblock %}"/>
    {#- Public pages set their path so duplicates (/accueil, /home, ?query) point search engines to one URL #}
    {%- if block('canonical_path') is defined %}
    <link rel="canonical" href="https://rockfever.be{{ block('canonical_path') }}"/>
    {%- endif %}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt"/>
    {#- Who runs the site, for search engines and AI assistants. The events on each page name it as organizer by its @id #}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'Organization',
                '@id': 'https://rockfever.be/#organization',
                name: 'Rock Fever',
                url: 'https://rockfever.be/',
                logo: 'https://rockfever.be/images/favicon.png',
                description: 'Soirées rock et valse ouvertes aux 18-35 ans à Louvain-la-Neuve, au Hall Sainte-Barbe.',
                address: {'@type': 'PostalAddress', addressLocality: 'Louvain-la-Neuve', postalCode: '1348', addressCountry: 'BE'},
                contactPoint: {'@type': 'ContactPoint', contactType: 'customer service', url: 'https://rockfever.be/contact', availableLanguage: 'fr'},
                sameAs: ['https://www.facebook.com/rockfeverlln', 'https://www.instagram.com/rockfeverlln/']
            },
            {
                '@type': 'WebSite',
                '@id': 'https://rockfever.be/#website',
                url: 'https://rockfever.be/',
                name: 'Rock Fever',
                inLanguage: 'fr-BE',
                publisher: {'@id': 'https://rockfever.be/#organization'}
            }
        ]
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

    <link rel="preload" href="{{ __DIR__ }}/fonts/material-icons.woff2?v=4c26ce59" as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href="{{ __DIR__ }}/fonts/inter.woff2?v=8e433c05" as="font" type="font/woff2" crossorigin/>
    {% block head %}{% endblock %}
    {# critical.css and site.css are built by bin/critical-css.php at every deploy (not in git) #}
    {%- if assetExists('/css/site.css') %}
    {# Rules the public pages need for the first paint, then the one stylesheet (Materialize's part and style.css),
       loaded in the background #}
    <style>{{ source('critical.css', ignore_missing = true) }}</style>
    <link rel="preload" href="{{ asset('/css/site.css') }}" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
    <noscript>
        <link rel="stylesheet" href="{{ asset('/css/site.css') }}"/>
    </noscript>
    {%- else %}
    {#- A fresh checkout has neither: the page waits for all of Materialize and style.css #}
    <link rel="stylesheet" href="{{ asset('/css/materialize.min.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/style.css') }}"/>
    {%- endif %}
    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
</head>

{#- "site" scopes the public pages' font, menu and footer styles: the admin uses the same style.css #}
<body class="site {% block bodyColor %}{% endblock %}">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {% include "topbar.twig" %}

    <main id="contenu" tabindex="-1">
    {% block body %}
    {% endblock %}
    </main>

    {% include "footer.twig" %}
</body>
</html>
