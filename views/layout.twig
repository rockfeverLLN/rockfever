<!DOCTYPE html>
<html lang="fr"{% if page is defined %} data-page="{{ page }}"{% endif %}>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <!-- Google tag (gtag.js), as Google gives it, so Analytics' tag check finds it. async: it doesn't block the page -->
    {#- Every script carries the page's nonce: the Content-Security-Policy blocks the others (ContentSecurityPolicyMiddleware) #}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MKKLSTRX4W" nonce="{{ csp_nonce }}"></script>
    <script nonce="{{ csp_nonce }}">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        {#- Analytics may set its cookies, with no banner: with storage denied, Google doesn't report the visits of a
            site this small (it only models them above 1,000 consenting users a day). Nothing for ads #}
        gtag('consent', 'default', {
            'analytics_storage': 'granted',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied'
        });
        gtag('js', new Date());

        gtag('config', 'G-MKKLSTRX4W');
        {#- What the visitor just did (a sign-up, a message...), queued by the action with FlashService::event() #}
        {%- set analytics_event = flash('event') %}
        {%- if analytics_event %}
        gtag('event', {{ analytics_event|json_encode(constant('JSON_HEX_TAG'))|raw }});
        {%- endif %}
    </script>
    <!-- The site's scripts are only needed once the page is shown: they load after its first paint, so that on a slow
         connection they don't hold it back -->
    <script nonce="{{ csp_nonce }}">
        (function () {
            var loaded = false;
            function loadScripts() {
                if (loaded) {
                    return;
                }
                loaded = true;
                var tag = document.createElement('script');
                tag.src = '{{ asset('/js/script.js') }}';
                document.head.appendChild(tag);
            }
            // The load event often comes before the first paint: wait for the browser to report that paint
            window.addEventListener('load', function () {
                try {
                    new PerformanceObserver(function () {
                        setTimeout(loadScripts);
                    }).observe({type: 'paint', buffered: true});
                } catch (e) {
                    // Browsers that don't report paints
                }
                setTimeout(loadScripts, 1000);
            });
        })();
    </script>
    <title>{% block title %}Rock Fever{% endblock %}</title>
    <meta name="description" content="{% block description %}Rock Fever, le rock à Louvain-la-Neuve : prochain événement, inscriptions et propositions de musique.{% endblock %}"/>
    {#- Public pages set their path so duplicates (/accueil, /home, ?query) point search engines to one URL #}
    {%- if block('canonical_path') is defined %}
    <link rel="canonical" href="https://rockfever.be{{ block('canonical_path') }}"/>
    {%- endif %}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt"/>
    <link rel="alternate" type="application/json" href="/api/events" title="Les soirées (JSON)"/>
    {#- A WebMCP tool, for the AI agents a browser lets act on the page: the next soirée, read from /api/events.
        Registered right away, not in script.js, so an agent (or Lighthouse) that looks as soon as the page loads finds it.
        The forms that act (sign-up, contact, music) are tools of their own, through their toolname attributes #}
    <script nonce="{{ csp_nonce }}">
        (function () {
            var modelContext = document.modelContext || navigator.modelContext;
            if (!modelContext || !modelContext.registerTool) {
                return;
            }
            modelContext.registerTool({
                name: 'get_next_soiree',
                description: "Donne la prochaine soirée du Rock Fever (date, heures, lieu, prix, thème) et l'état de ses inscriptions "
                    + "(soiree.registration.status : open, upcoming, pending, closed ou cancelled), avec des suites à proposer "
                    + "(l'ajouter à son calendrier, un rappel). Les mêmes données que https://rockfever.be/api/events.",
                inputSchema: {type: 'object', properties: {}},
                annotations: {readOnlyHint: true},
                execute: function () {
                    return fetch('/api/events', {headers: {Accept: 'application/json'}})
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (data) {
                            // The soirée itself carries its sign-up's state; data.registration explains the states
                            var soiree = (data.events || []).filter(function (event) {
                                return event.id === data.next;
                            })[0] || null;
                            var next = {
                                nextSummary: data.nextSummary,
                                soiree: soiree,
                                registrationStatuses: data.registration && data.registration.statuses,
                                suggestions: data.suggestions
                            };
                            return {content: [{type: 'text', text: JSON.stringify(next)}]};
                        });
                }
            });
        })();
    </script>
    {#- Who runs the site, for search engines and AI assistants. The events on each page name it as organizer by its @id #}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'Organization',
                '@id': 'https://rockfever.be/#organization',
                name: 'Rock Fever',
                url: 'https://rockfever.be/',
                logo: 'https://rockfever.be/images/favicon.png',
                description: 'Soirées rock et valse ouvertes aux 18-35 ans à Louvain-la-Neuve, au ' ~ setting('SOIREE_PLACE') ~ '.',
                address: {'@type': 'PostalAddress', addressLocality: 'Louvain-la-Neuve', postalCode: '1348', addressCountry: 'BE'},
                contactPoint: {'@type': 'ContactPoint', contactType: 'customer service', url: 'https://rockfever.be/contact', availableLanguage: 'fr'},
                sameAs: [setting('FACEBOOK_URL'), setting('INSTAGRAM_URL')]
            },
            {
                '@type': 'WebSite',
                '@id': 'https://rockfever.be/#website',
                url: 'https://rockfever.be/',
                name: 'Rock Fever',
                inLanguage: 'fr-BE',
                publisher: {'@id': 'https://rockfever.be/#organization'}
            }
        ]
    }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>

    <link rel="preload" href="{{ __DIR__ }}/fonts/material-icons.woff2?v=4c26ce59" as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href="{{ __DIR__ }}/fonts/inter.woff2?v=8e433c05" as="font" type="font/woff2" crossorigin/>
    {% block head %}{% endblock %}
    {# critical.css and site.css are built by bin/critical-css.php at every deploy (not in git) #}
    {%- if assetExists('/css/site.css') %}
    {# Rules the page needs for the first paint, then the one stylesheet (base.css's part and style.css), loaded in
       the background. The rules of this page only when bin/critical-css.php read it, else those of all the pages #}
    {%- set critical = page is defined ? source('critical/' ~ page ~ '.css', ignore_missing = true) : '' %}
    <style>{{ critical ?: source('critical.css', ignore_missing = true) }}</style>
    <link rel="preload" href="{{ asset('/css/site.css') }}" as="style" id="site-css"/>
    {#- Not an onload attribute: the Content-Security-Policy blocks those. The script runs before the file can load #}
    <script nonce="{{ csp_nonce }}">
        document.getElementById('site-css').onload = function () {
            this.onload = null;
            this.rel = 'stylesheet';
        };
    </script>
    <noscript>
        <link rel="stylesheet" href="{{ asset('/css/site.css') }}"/>
    </noscript>
    {%- else %}
    {#- A fresh checkout has neither: the page waits for all of base.css and style.css #}
    <link rel="stylesheet" href="{{ asset('/css/base.css') }}"/>
    <link rel="stylesheet" href="{{ asset('/css/style.css') }}"/>
    {%- endif %}
    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
</head>

{#- "site" scopes the public pages' font, menu and footer styles: the admin uses the same style.css #}
<body class="site {% block bodyColor %}{% endblock %}">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {% include "topbar.twig" %}

    <main id="contenu" tabindex="-1">
    {% block body %}
    {% endblock %}
    </main>

    {% include "footer.twig" %}
</body>
</html>
