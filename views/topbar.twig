<nav class="koamaru" aria-label="Menu principal">
    <div class="nav-wrapper container">
        <a href="{{ path('home') }}" class="brand-logo" aria-label="Rock Fever, accueil">Rock Fever</a>
        <a href="#" data-target="mobile-demo" class="sidenav-trigger" aria-label="Ouvrir le menu" aria-controls="mobile-demo">
            <i class="material-icons" aria-hidden="true">menu</i>
        </a>
        {#- No "Accueil" here: the logo already leads home #}
        <ul class="right hide-on-med-and-down">
            {% if nextEventExist() %}
            <li class="{{ isSubPath('event') ? 'active' }}">
                <a href="{{ path('event') }}"><i class="mdi mdi-calendar left" aria-hidden="true"></i> Prochain événement</a>
            </li>
            {% endif %}
            <li class="{{ isSubPath('calendar') ? 'active' }}">
                <a href="{{ path('calendar') }}"><i class="mdi mdi-calendar-multiple left" aria-hidden="true"></i> Calendrier</a>
            </li>
            <li class="{{ isSubPath('photos') ? 'active' }}">
                <a href="{{ path('photos') }}"><i class="mdi mdi-camera left" aria-hidden="true"></i> Photos</a>
            </li>
            <li class="{{ isSubPath('music') ? 'active' }}">
                <a href="{{ path('music') }}"><i class="mdi mdi-music left" aria-hidden="true"></i> Proposer un rock</a>
            </li>
            <li class="{{ isSubPath('contact') ? 'active' }}">
                <a href="{{ path('contact') }}"><i class="mdi mdi-email-outline left" aria-hidden="true"></i> Contact</a>
            </li>
        </ul>
    </div>
</nav>

{#- A div with the role, not a <nav>: base.css styles every nav as the top bar #}
<div role="navigation" aria-label="Menu mobile">
    <ul class="sidenav" id="mobile-demo">
        <li class="{{ isSubPath('home') ? 'active' }}">
            <a href="{{ path('home') }}">Accueil</a>
        </li>
        {% if nextEventExist() %}
        <li class="{{ isSubPath('event') ? 'active' }}">
            <a href="{{ path('event') }}">Prochain événement</a>
        </li>
        {% endif %}
        <li class="{{ isSubPath('calendar') ? 'active' }}">
            <a href="{{ path('calendar') }}">Calendrier</a>
        </li>
        <li class="{{ isSubPath('photos') ? 'active' }}">
            <a href="{{ path('photos') }}">Photos</a>
        </li>
        <li class="{{ isSubPath('music') ? 'active' }}">
            <a href="{{ path('music') }}">Proposer un rock</a>
        </li>
        <li class="{{ isSubPath('contact') ? 'active' }}">
            <a href="{{ path('contact') }}">Contact</a>
        </li>
    </ul>
</div>
