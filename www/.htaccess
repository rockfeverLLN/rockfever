# No file listings for folders (css/, js/, images/)
Options -Indexes

RewriteEngine on
# The site lives on https://rockfever.be: send www to it in one hop
RewriteCond %{HTTP_HOST} ^www\.rockfever\.be$ [NC]
RewriteRule ^ https://rockfever.be%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE,QSA]
# Browsers ask for /favicon.ico on every page: serve the PNG favicon there
RewriteRule ^favicon\.ico$ /images/favicon.png [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.php [NC,L,QSA]

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/jxl .jxl
AddType "text/markdown; charset=utf-8" .md
AddType "text/plain; charset=utf-8" .txt

# Security headers, on every response (pages, files and errors). The CSP doesn't list script or image sources:
# the admin loads TinyMCE and fonts from CDNs, and the About sections can embed videos. The pages, admin included,
# add a second policy for their scripts (ContentSecurityPolicyMiddleware), which browsers apply together with this one
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Let browsers cache static files. Images are replaced under a new name; CSS/JS without a ?v= version get less.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jxl "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>

# Versioned CSS, JS and fonts (?v=, see src/Framework/Twig/AssetExtension.php) get a new URL whenever they change:
# keep them for a year
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=/">
            Header set Cache-Control "public, max-age=31536000, immutable"
            Header unset Expires
        </If>
    </FilesMatch>
</IfModule>
