parameters:
	ignoreErrors:
		-
			message: '#^Variable \$argv might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: bin/critical-css.php

		-
			message: '#^Variable \$argv might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: bin/fix-double-utf8.php

		-
			message: '#^Property App\\Auth\\Actions\\LoginAttemptAction\:\:\$renderer is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Auth/Actions/LoginAttemptAction.php

		-
			message: '#^Property App\\Events\\Actions\\EventCloseAction\:\:\$renderer is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Events/Actions/EventCloseAction.php

		-
			message: '#^Property App\\Events\\Actions\\EventOpenAction\:\:\$renderer is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Events/Actions/EventOpenAction.php

		-
			message: '#^Access to an undefined property Framework\\Actions\\AjaxAction\:\:\$router\.$#'
			identifier: property.notFound
			count: 1
			path: src/Framework/Actions/AjaxAction.php

		-
			message: '#^Call to function is_null\(\) with object will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: src/Framework/App.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: src/Framework/App.php

		-
			message: '#^Method Framework\\App\:\:getMiddleware\(\) should return object but returns null\.$#'
			identifier: return.type
			count: 1
			path: src/Framework/App.php

		-
			message: '#^Call to an undefined method Psr\\Http\\Server\\MiddlewareInterface\:\:getCallback\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Framework/Router.php

		-
			message: '#^Method Framework\\Validator\:\:getErrors\(\) should return array\<Framework\\Validator\\ValidationError\> but returns array\<string\>\.$#'
			identifier: return.type
			count: 1
			path: src/Framework/Validator.php

		-
			message: '#^Strict comparison using \!\=\= between Psr\\Http\\Message\\UploadedFileInterface and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Framework/Validator.php

		-
			message: '#^Strict comparison using \=\=\= between Psr\\Http\\Message\\UploadedFileInterface and null will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Framework/Validator.php

		-
			message: '#^Property Framework\\Validator\\ValidationError\:\:\$key is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Framework/Validator/ValidationError.php

		-
			message: '#^Call to an undefined method Framework\\Database\\Table\:\:findHigherPositions\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Main/Actions/AboutCrudAction.php

		-
			message: '#^Call to an undefined method Framework\\Database\\Table\:\:findMaximumPosition\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Main/Actions/AboutCrudAction.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 2
			path: src/Main/Actions/AboutSectionMoveAction.php

		-
			message: '#^Parameter \#2 \$value of method Framework\\Database\\Table\:\:findBy\(\) expects string, \(float\|int\) given\.$#'
			identifier: argument.type
			count: 2
			path: src/Main/Actions/AboutSectionMoveAction.php

		-
			message: '#^Call to an undefined method Framework\\Database\\Table\:\:getValue\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Main/Actions/ContactAction.php

		-
			message: '#^Call to function compact\(\) contains possibly undefined variable \$errors\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Main/Actions/ContactAction.php

		-
			message: '#^Call to function compact\(\) contains possibly undefined variable \$item\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Main/Actions/ContactAction.php

		-
			message: '#^Using nullsafe property access "\?\-\>coveventLink" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Main/Calendar.php
