{
    "name": "rockfever/site",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "guzzlehttp/psr7": "^2.7",
        "intervention/image": "^2.7",
        "laminas/laminas-httphandlerrunner": "^2.10",
        "mezzio/mezzio-fastroute": "^3.11",
        "middlewares/whoops": "^2.0",
        "pagerfanta/pagerfanta": "^4.7",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "psr/container": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Framework\\": "src/Framework/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "robmorgan/phinx": "^0.16.12"
    }
}
