{
    "name": "rockfever/site",
    "description": "Rock Fever website",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "guzzlehttp/psr7": "^3.2",
        "intervention/image": "^4.4",
        "laminas/laminas-httphandlerrunner": "^2.10",
        "league/html-to-markdown": "^5.1",
        "mezzio/mezzio-fastroute": "^3.11",
        "middlewares/whoops": "^2.0",
        "pagerfanta/pagerfanta": "^4.7",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^7.1",
        "psr/container": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Framework\\": "src/Framework/"
        },
        "exclude-from-classmap": [
            "src/*/db/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.3",
        "robmorgan/phinx": "^0.16.12"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "ENV=dev php -S 127.0.0.1:8000 -t www bin/router.php"
        ],
        "lint": "find src config www -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "analyse": "phpstan analyse --memory-limit=1G",
        "migrate": "phinx migrate",
        "seed": "phinx seed:run"
    },
    "scripts-descriptions": {
        "serve": "Run the site locally on http://127.0.0.1:8000",
        "lint": "Check every PHP file for syntax errors",
        "analyse": "Look for code that calls classes or methods that don't exist (new errors only, see phpstan.neon)",
        "migrate": "Apply database migrations",
        "seed": "Fill the database with sample data"
    }
}
