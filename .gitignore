# Composer dependencies (installed by the deploy workflow)
/vendor/

# Twig / proxy caches written at runtime
/tmp/

# Photos of the gallery, uploaded in the admin (src/Photos/PhotoUpload.php)
/storage/

# Database credentials: copy config/database.example.php to create it
/config/database.php

# Environment and logs
.env
*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Written by bin/deploy.sh
/.deployed-sha

# Built by bin/critical-css.php at every deploy (deploy.yml)
/views/critical.css
/views/critical/
/www/css/site.css

# Images pasted into the About sections, saved as files when a page shows them (TextExtension::pastedToFile)
/www/images/about/pasted/

# The JPEG XL encoder, downloaded by deploy.yml
/bin/cjxl
/bin/.cjxl-hash
