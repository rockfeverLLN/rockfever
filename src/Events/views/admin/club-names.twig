{% extends '@admin/layout.twig' %}
{% block title %}Noms des danseurs - Rock Fever{% endblock %}

{% block body %}
    <div class="container club-stats">
        <div class="club-stats-header">
            <h1>Noms des danseurs</h1>
            <a href="{{ path('admin.statistics') }}" class="btn-flat">Retour aux statistiques</a>
        </div>
        <p class="club-stats-intro">
            Un danseur inscrit sous deux orthographes compte pour deux dans les statistiques. Dites ici quels noms sont
            la même personne : seules les statistiques changent, les listes des soirées gardent ce qui a été écrit, et
            chaque choix peut être annulé.
        </p>

        <section class="dashboard-card">
            <h2>Même personne ?</h2>
            {% if suggestions.pairs %}
                <p class="club-stats-note">
                    <strong><span id="name-pairs-left" aria-live="polite">{{ suggestions.total }}</span> paire{{ suggestions.total > 1 ? 's' }} à vérifier.</strong>
                    Pour chacune, répondez <strong>Même personne</strong> ou <strong>Deux personnes</strong> : c'est
                    enregistré tout de suite, et la suivante arrive. Le nom en gras est celui qui sera gardé.
                </p>
                {% if suggestions.sure > 0 %}
                    <form method="post" action="{{ path('admin.statistics.names.save') }}" class="name-pairs-sure">
                        <p>
                            <strong>{{ suggestions.sure }} paire{{ suggestions.sure > 1 ? 's' }} {{ suggestions.sure > 1 ? 'ont' : 'a' }} exactement les mêmes lettres</strong> :
                            seuls les espaces ou la coupure entre prénom et nom changent. C'est presque toujours la même personne.
                        </p>
                        <button type="submit" name="sure" value="1" class="btn koamaru">Tout regrouper ({{ suggestions.sure }})</button>
                    </form>
                {% endif %}
                <div id="name-pairs">
                    {% for pair in suggestions.pairs %}
                        <form method="post" action="{{ path('admin.statistics.names.save') }}" class="name-pair">
                            <input type="hidden" name="pairs[0][a]" value="{{ pair.a.key }}">
                            <input type="hidden" name="pairs[0][b]" value="{{ pair.b.key }}">
                            <p class="name-pair-names">
                                <strong>{{ pair.a.name }}</strong> <small>{{ pair.a.signUps }} inscription{{ pair.a.signUps > 1 ? 's' }}</small>
                                <span class="name-pair-and">et</span>
                                {{ pair.b.name }} <small>{{ pair.b.signUps }} inscription{{ pair.b.signUps > 1 ? 's' }}</small>
                            </p>
                            <p class="name-pair-reason">{{ pair.a.name == pair.b.name ? 'Écrit pareil, mais coupé autrement entre prénom et nom' : pair.reason }}</p>
                            <div class="name-pair-answers">
                                <button type="submit" name="pairs[0][choice]" value="a" class="btn koamaru" aria-label="Même personne : garder {{ pair.a.name }}">Même personne</button>
                                <button type="submit" name="pairs[0][choice]" value="different" class="btn-flat" aria-label="{{ pair.a.name }} et {{ pair.b.name }} sont deux personnes">Deux personnes</button>
                                {% if pair.a.name != pair.b.name %}
                                    <button type="submit" name="pairs[0][choice]" value="b" class="name-pair-other">Même personne, mais garder « {{ pair.b.name }} »</button>
                                {% endif %}
                            </div>
                        </form>
                    {% endfor %}
                </div>
            {% else %}
                <p class="dashboard-empty">Aucun nom ne se ressemble assez pour être vérifié.</p>
            {% endif %}
        </section>

        <section class="dashboard-card">
            <h2>Rapprocher deux noms</h2>
            <p class="club-stats-note">Pour ceux que la page ne trouve pas seule, comme un surnom.</p>
            <form method="post" action="{{ path('admin.statistics.names.save') }}" class="name-match-form">
                <div>
                    <label for="name-wrong">Le nom à corriger</label>
                    <input type="text" id="name-wrong" name="wrong" list="dancer-names" autocomplete="off" required>
                </div>
                <div>
                    <label for="name-right">Le nom à garder</label>
                    <input type="text" id="name-right" name="right" list="dancer-names" autocomplete="off" required>
                </div>
                <button type="submit" class="btn koamaru">Rapprocher</button>
                <datalist id="dancer-names">
                    {% for dancer in dancers %}
                        <option value="{{ dancer.name }}"></option>
                    {% endfor %}
                </datalist>
            </form>
        </section>

        {% for kind, title in {same: 'Noms rapprochés', different: 'Gardés séparés'} %}
            {% if choices[kind] %}
                <section class="dashboard-card">
                    <h2>{{ title }}</h2>
                    <table class="dashboard-table">
                        <thead>
                        <tr>
                            <th scope="col">{{ kind == 'same' ? 'Ce nom' : 'Ces deux noms' }}</th>
                            <th scope="col">{{ kind == 'same' ? 'Compte pour' : 'Sont deux personnes' }}</th>
                            <th scope="col" class="right-align">Annuler</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for choice in choices[kind] %}
                            <tr>
                                <td>{{ choice.name }}</td>
                                <td>{{ choice.other }}</td>
                                <td class="right-align">
                                    <form method="post" action="{{ path('admin.statistics.names.save') }}">
                                        <input type="hidden" name="undo" value="{{ choice.id }}">
                                        <button type="submit" class="btn-flat" aria-label="Annuler le choix pour {{ choice.name }} et {{ choice.other }}">Annuler</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}
