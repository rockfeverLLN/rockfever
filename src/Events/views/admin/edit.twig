{% extends '@admin/layout.twig' %}

{% block title %}{{ item.title }} - Rock Fever{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ item.title }}</h1>
        <form action="{{ path('admin.events.edit', {id:item.id}) }}" method="post">
            <div class="row">
                {% include '@events/admin/form.twig' %}
                <div class="col s12">
                    <button class="btn koamaru right">Modifier l'événement</button>
                    <a href="{{ path('admin.events.index') }}" class="btn-flat red-text right">Annuler</a>
                </div>
            </div>
        </form>


    </div>

{% endblock %}
