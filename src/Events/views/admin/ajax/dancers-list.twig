{% for dancer in dancers %}
    {#- data-name is what the search in www/js/guests.js matches, the .guest-name parts are where it highlights #}
    <li class="collection-item" style="position:relative;" data-name="{{ dancer.firstname }} {{ dancer.lastname }}">

        <span>
            {% if dancer.status == 2 %}
                <i class="material-icons amber-text left">star</i>
            {% endif %}
            {% if dancer.status == 3 %}
                <i class="material-icons koamaru-text left">exposure_plus_1</i>
            {% endif %}
            <span class="guest-name">{{ dancer.firstname }}</span> <b class="guest-name">{{ dancer.lastname }}</b>
        </span>

        <div class="progress loader" style="display:none; margin:0;position: absolute; bottom: 0;">
            <div class="indeterminate"></div>
        </div>

        {% if dancer.status == 0 %}
            <button
                    class="transparent green-text waves-green waves-effect secondary-content tab-highlighted"
                    data-dancer="{{ dancer.id }}" data-status="1"
            >
                <i class="material-icons left">check</i> Ajouter
            </button>
        {% endif %}

        {% if dancer.status == 0 %}
            <button
                    class="transparent amber-text waves-effect waves-yellow secondary-content tab-highlighted"
                    style="border-radius: 50%"
                    data-dancer="{{ dancer.id }}" data-status="2"
            >
                <i class="material-icons">star</i>
            </button>
        {% endif %}

        {% if dancer.status > 0 %}
            <button
                    class="transparent red-text waves-red waves-effect secondary-content tab-highlighted"
                    data-dancer="{{ dancer.id }}" data-status="0"
            >
                <i class="material-icons left">close</i> Retirer
            </button>
        {% endif %}
    </li>
{% endfor %}