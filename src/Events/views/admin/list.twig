{% extends '@admin/layout.twig' %}
{% block title %}Liste de l'événement {{ id }} - Rock Fever{% endblock %}

{% block body %}
    <div class="row" style="height: calc(85% - 64px); margin-bottom: 0;">
        <div class="col s12 m7 l8 dancers-list dancers-list-background white-text">
            <div class="container">
                <div class="row">
                    <h1 style="margin-top: 80px"><label for="guest-search" class="guest-search-label">Recherchez un danseur :</label></h1>
                    <div class="col s12 m10 offset-m1">
                        <input type="text" name="dancers-search" autocomplete="off" placeholder="Nom du danseur" id="guest-search"
                               aria-controls="guests-list">
                    </div>
                    <a href="{{ path('admin.events.statistics', {id: id}) }}" class="col s12 m4 offset-m1 center-align event-list-stat white-text" aria-live="polite">
                        <strong id="attendees">-</strong>
                        <br>
                        personnes au total
                        (<span id="revenue">- €</span>)
                        <br>
                        <span id="venue-stats">- % des pré-inscrits</span>
                    </a>
                    <div class="col hide-on-small-only m4 offset-m2 center-align event-list-stat" aria-live="polite">
                        <strong id="improvised">-</strong>
                        <br>
                        venues improvisées
                    </div>
                </div>
            </div>
        </div>
        <div class="col s12 m5 l4 guests-list">
            <ul class="collection" id="guests-list" style="margin: 0;" aria-label="Danseurs"
                data-event="{{ id }}"
                data-list-url="{{ path('admin.ajax.dancers.load-list', {id: id}) }}"
                data-stats-url="{{ path('admin.ajax.dancers.get-stats', {id: id}) }}"
                data-status-url="{{ path('admin.ajax.dancer.update-status') }}"
                data-add-url="{{ path('admin.ajax.dancer.add-improvised') }}"
                data-remove-url="{{ path('admin.ajax.dancer.remove') }}">

            </ul>
            <div class="grey lighten-1 white-text guests-list-nothing" style="width: 100%; height: 100%;" role="status">
                <div>
                    <i class="material-icons" style="font-size:100px; display: block;" aria-hidden="true">search</i>
                    Aucun élément à afficher
                </div>
            </div>
        </div>
    </div>

    <div class="row koamaru dancers-list white-text" style="height: 15%; width: 100%; margin-bottom: 0;">
        <div class="container">
            <div class="row">
                <div class="col s12" style="margin-top: 8px; margin-bottom: 3px">
                    <h2 id="improvised-title" style="font-size: 20px; font-weight: 400; margin: 0;">Ajouter un participant :</h2>
                </div>
                <div class="col s12 m5">
                    <input type="text" id="improvised-firstname" name="firstname" autocomplete="off" placeholder="Prénom"
                           aria-label="Prénom du participant à ajouter">
                </div>
                <div class="col s12 m5">
                    <input type="text" id="improvised-lastname" name="lastname" autocomplete="off" placeholder="Nom"
                           aria-label="Nom du participant à ajouter">
                </div>
                <div class="col s12 m2">
                    <button type="button" id="improvised-button" aria-describedby="improvised-title">Ajouter</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
    <script nonce="{{ csp_nonce }}" src="{{ asset('/js/guests.js') }}"></script>
{% endblock %}
