{% extends '@admin/layout.twig' %}
{% block title %}Événements - Rock Fever{% endblock %}
{% block body %}
    <div class="container">
        <h1>Événements</h1>
        {% include '@events/admin/tabs.twig' with {current: 'admin.events.index'} %}

        {#- The usual times, place, prices and sign-up opening: every page, calendar and new event takes them from here
            (App\Main\Settings). Only admins change them (www/index.php) #}
        {%- set s = settings|map(setting => setting.value) %}
        <details class="events-settings">
            <summary>
                <i class="mdi mdi-cog left" aria-hidden="true"></i><strong>Réglages des soirées</strong>
                <span class="grey-text">
                    · valse {{ s.SOIREE_WALTZ_TIME|replace({':': 'h'}) }}, rock {{ s.SOIREE_ROCK_TIME|replace({':': 'h'}) }},
                    fin {{ s.SOIREE_END_TIME|replace({':': 'h'}) }} · {{ s.SOIREE_PLACE }}
                    · {{ s.PRICE_ONLINE }}&nbsp;€ inscrit, {{ s.PRICE_DOOR }}&nbsp;€ sur place
                    · inscriptions {{ s.REGISTRATION_DAYS }}&nbsp;jours avant
                </span>
            </summary>
            {% if isAdmin() %}
                <form action="{{ path('admin.events.settings') }}" method="post" class="row">
                    {% for name, setting in settings %}
                        <div class="col s12 {{ setting.type == 'string' ? 'm6' : 'm4' }}">
                            {%- if setting.type == 'time' %}
                                {{ field(name, setting.value, setting.label, {type: 'time', attributes: {required: true}}) }}
                            {%- elseif setting.type == 'int' %}
                                {{ field(name, setting.value, setting.label, {attributes: {required: true, inputmode: 'numeric', pattern: '[0-9]{1,3}'}}) }}
                            {%- else %}
                                {{ field(name, setting.value, setting.label, {attributes: {required: true, maxlength: 250}}) }}
                            {%- endif %}
                        </div>
                    {% endfor %}
                    <div class="col s12">
                        <p class="grey-text">
                            Valent pour toutes les soirées, sauf les heures et le lieu qu'un événement a changés (sa
                            page «&nbsp;Modifier&nbsp;»).
                        </p>
                        <button class="btn koamaru">Enregistrer les réglages</button>
                    </div>
                </form>
            {% else %}
                <p class="grey-text">Seuls les administrateurs peuvent changer ces réglages.</p>
            {% endif %}
        </details>

        {#- Dates first, without theme: /calendrier and the calendars show them right away. Their event (theme,
            description, Facebook) comes later, with the sign-up, from "Créer l'événement". With "Jusqu'au", the same
            weekday every week: a whole quadrimestre at once #}
        <form action="{{ path('admin.events.dates.create') }}" method="post" class="row events-new-date">
            <div class="col s12 m4">{{ field('date', '', 'Date de la soirée (ou la première)', {type: 'date', idSuffix: 'new', attributes: {required: true}}) }}</div>
            <div class="col s12 m3">
                {{ field('until', '', 'Jusqu\'au (facultatif)', {type: 'date', idSuffix: 'new'}) }}
                <span class="helper-text">Une date par semaine, le même jour.</span>
            </div>
            <div class="col s8 m3">{{ field('week', '', 'Semaine (ex. S1)', {idSuffix: 'new', attributes: {maxlength: 10}}) }}</div>
            <div class="col s4 m2"><button class="btn koamaru events-new-date-button">Ajouter</button></div>
        </form>

        <ul class="collapsible" style="box-shadow: none; border: none">
            {% for soiree in soirees %}
                {% set event = soiree.event %}
                <li {% if loop.first %}class="active" {% endif %}>
                    <div class="collapsible-header" style="position: relative;">
                        <i class="material-icons" aria-hidden="true">event</i>{{ soiree.label }} {{ soiree.year }}
                        {% if soiree.week %}<span class="grey-text">&nbsp;· {{ soiree.week }}</span>{% endif %}
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        {% if soiree.cancelled %}
                            <strong class="red-text">Annulée</strong>
                        {% elseif event %}
                            <strong>{{ event.title }}</strong>
                        {% else %}
                            <em class="grey-text">Pas encore d'événement ni de thème</em>
                        {% endif %}
                        {% if event %}
                            <div style="position: absolute; right:30px">
                                <i class="material-icons left" aria-hidden="true">supervisor_account</i>
                                <strong>{{ participants[event.id] | default(0) }}</strong>
                                participants
                            </div>
                        {% endif %}
                    </div>
                    <div class="collapsible-body">
                        <p style="margin-top: 0">
                            {% set registration = soiree.registration %}
                            {% if registration.status == 'open' %}
                                Inscriptions ouvertes jusqu'au début de la soirée.
                            {% elseif registration.status == 'upcoming' %}
                                Les inscriptions s'ouvriront toutes seules le {{ registration.opens | dayLabel }}{{ event ? '' : ', si son événement est créé' }}.
                            {% elseif registration.status == 'pending' %}
                                Les inscriptions attendent son événement : crée-le pour les ouvrir.
                            {% elseif registration.status == 'cancelled' %}
                                Soirée annulée : le site et les calendriers l'annoncent annulée.
                            {% else %}
                                Inscriptions fermées.
                            {% endif %}
                        </p>

                        {% if event %}
                            {% include '@events/admin/actions.twig' %}
                        {% elseif not soiree.cancelled %}
                            <a href="{{ path('admin.events.create') }}?date={{ soiree.date }}" class="btn koamaru">
                                <i class="mdi mdi-calendar-plus left" aria-hidden="true"></i>Créer l'événement (thème, description…)
                            </a>
                        {% endif %}

                        {% if soiree.soireeId %}
                            <form action="{{ path('admin.events.dates.edit', {id: soiree.soireeId}) }}" method="post" class="row events-date-form">
                                <div class="col s6 m4">{{ field('week', soiree.week, 'Semaine', {idSuffix: soiree.soireeId, attributes: {maxlength: 10}}) }}</div>
                                <div class="col s6 m4">
                                    <p>
                                        <label>
                                            <input type="hidden" name="cancelled" value="0">
                                            <input type="checkbox" name="cancelled" value="1" {{ soiree.cancelled ? 'checked' }}>
                                            <span>Soirée annulée</span>
                                        </label>
                                    </p>
                                </div>
                                <div class="col s12 m4"><button class="btn-flat koamaru-text">Enregistrer</button></div>
                            </form>
                            <form action="{{ path('admin.events.dates.delete', {id: soiree.soireeId}) }}" method="post"
                                  data-confirm="Supprimer cette date du calendrier ? Pour une soirée qui n'aura pas lieu, coche plutôt « Soirée annulée » : les calendriers qui l'ont l'annonceront annulée.">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn-flat red-text"><i class="mdi mdi-delete left" aria-hidden="true"></i>Supprimer la date</button>
                            </form>
                        {% else %}
                            {#- An event created for a day without a planned date: the site shows it all the same #}
                            <form action="{{ path('admin.events.dates.create') }}" method="post">
                                <input type="hidden" name="date" value="{{ soiree.date }}">
                                <button type="submit" class="btn-flat koamaru-text">Ajouter ce jour aux dates planifiées</button>
                            </form>
                        {% endif %}
                    </div>
                </li>
            {% else %}
                <li><p>Aucune soirée à venir : ajoute les dates du prochain quadrimestre ci-dessus.</p></li>
            {% endfor %}
        </ul>
    </div>

    <div class="fixed-action-btn">
        <a href="{{ path('admin.events.create') }}" class="pulse btn-floating btn-large koamaru" aria-label="Nouvel événement" title="Nouvel événement">
            <i class="mdi mdi-calendar-plus" aria-hidden="true"></i>
        </a>
    </div>
{% endblock %}
