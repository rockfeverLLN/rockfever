<div class="col s12">
    <div class="row">
        <div class="col s12 m6">
            {{ field('title', item.title, 'Titre de l\'événement') }}
        </div>
        <div class="col s12 m6">
            {{ field('date', item.date, 'Date de l\'événement', {class: 'datepicker'}) }}
        </div>
    </div>
</div>
<div class="col s12">
    <div class="row">
        <div class="col s12 m3">
            {{ field('waltz_time', item.waltzTime, 'Heure de la valse', {class: 'timepicker'}) }}
        </div>
        <div class="col s12 m3">
            {{ field('rock_time', item.rockTime, 'Heure du rock', {class: 'timepicker'}) }}
        </div>
        <div class="col s12 m3">
            {{ field('place', item.place, 'Lieu') }}
        </div>
        <div class="col s12 m3">
            {{ field('price', item.price, 'Prix') }}
        </div>
    </div>
</div>
<div class="col s12">
    <div class="row">
        <div class="col s12 m6">
            {{ field('covevent_link', item.coveventLink, 'Lien vers le covevent') }}
        </div>
        <div class="col s12 m6">
            {{ field('facebook_link', item.facebookLink, 'Lien vers l\'événement Facebook') }}
        </div>
        <div class="col s12 m6">
            {{ field('photos_password', item.photosPassword, 'Mot de passe des photos') }}
            <span class="helper-text">Donné aux danseurs de la soirée : il ouvre son album sur /photos. Vide, seule l'équipe voit l'album.</span>
        </div>
    </div>
</div>
<div class="col s12">
    {{ field('description', item.description, 'Description de l\'événement', {type: 'textarea'}) }}
</div>