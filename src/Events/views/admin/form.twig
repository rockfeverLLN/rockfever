<div class="col s12">
    <div class="row">
        <div class="col s12 m6">
            {{ field('title', item.title, 'Titre de l\'événement') }}
        </div>
        <div class="col s12 m6">
            {{ field('date', item.date, 'Date de l\'événement', {type: 'date'}) }}
            {#- When sign-ups open, said as on the site (src/Main/views/registration.twig); www/js/script.js says it again
                when the date changes #}
            <span class="helper-text" id="date-registration" data-ends="{{ soireeEnds|default({})|json_encode }}"
                  data-days="{{ registrationDays }}" aria-live="polite">
                {%- if registrationOpens|default(null) is null -%}
                    Inscriptions sur le site {{ registrationDays }} jours avant, à minuit, jusqu’au début de la soirée.
                {%- elseif registrationOpens|date('U') > 'now'|date('U') -%}
                    Inscriptions sur le site dès le {{ registrationOpens|dayLabel }}{% if registrationOpens|date('H:i', false) != '00:00' %} à&nbsp;{{ registrationOpens|date('H:i', false)|replace({':': 'h'}) }}{% endif %}, jusqu’au début de la soirée.
                {%- else -%}
                    Inscriptions sur le site dès l’enregistrement de l’événement, jusqu’au début de la soirée.
                {%- endif -%}
            </span>
        </div>
    </div>
</div>
<div class="col s12">
    <div class="row">
        <div class="col s12 m3">
            {{ field('waltz_time', item.waltzTime, 'Heure de la valse', {type: 'time'}) }}
        </div>
        <div class="col s12 m3">
            {{ field('rock_time', item.rockTime, 'Heure du rock', {type: 'time'}) }}
        </div>
        <div class="col s12 m6">
            {{ field('place', item.place, 'Lieu, si ce n\'est pas le ' ~ usualPlace) }}
            <span class="helper-text">Vide : {{ usualPlace }}. Les heures, le lieu et les prix habituels se règlent sur la page Événements.</span>
        </div>
    </div>
</div>
<div class="col s12">
    <div class="row">
        <div class="col s12 m6">
            {{ field('facebook_link', item.facebookLink, 'Lien vers l\'événement Facebook (facultatif)') }}
        </div>
        <div class="col s12 m6">
            {{ field('photos_password', item.photosPassword, 'Mot de passe des photos (facultatif)') }}
            <span class="helper-text">Donné aux danseurs de la soirée : il ouvre son album sur /photos. Vide, seule l'équipe voit l'album.</span>
        </div>
    </div>
</div>
<div class="col s12">
    {#- Not saved: pasting the link fills the description below with the post's text (www/js/script.js) #}
    {{ field('facebook_post', '', 'Lien vers le post Facebook qui annonce la soirée') }}
    <span class="helper-text" id="facebook_post-status" data-url="{{ path('admin.ajax.facebook-post') }}" aria-live="polite">
        Colle-le ici : son texte remplit la description, que tu peux encore modifier.
    </span>
</div>
<div class="col s12">
    {{ field('description', item.description, 'Description de l\'événement', {type: 'textarea'}) }}
</div>