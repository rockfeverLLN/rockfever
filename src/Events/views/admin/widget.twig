<div class="col s12 m6">
    <section class="dashboard-card dashboard-chart">
        <h2>Participants</h2>
        {#- The chart fills the rest of the card, as tall as the next event's beside it #}
        <div class="dashboard-chart-canvas">
            <canvas id="dancersChart" aria-hidden="true"></canvas>
        </div>
        {#- The chart's numbers, for screen readers #}
        <div class="sr-only"><table>
            <caption>Participants des dernières soirées</caption>
            <thead>
            <tr>
                <th scope="col">Soirée</th>
                <th scope="col">Pré-inscrits venus</th>
                <th scope="col">Sans inscription</th>
                <th scope="col">Total</th>
            </tr>
            </thead>
            <tbody>
            {% for event in countForChart %}
                <tr>
                    <th scope="row">{{ event.title }}</th>
                    <td>{{ event.count - event.improvised }}</td>
                    <td>{{ event.improvised }}</td>
                    <td>{{ event.count }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table></div>
    </section>
</div>

<div class="col s12 m6">
    {#- Navy like the next soirée's card on the home page (nextSoiree.twig) #}
    <section class="dashboard-card dashboard-next koamaru">
        {#- On its day and until the morning after, "Ce soir" as on the home page #}
        {%- set heading = tonight ? 'Ce soir' : 'Prochain rock' %}
        <h2>
            {% if nextEvent %}
                <a href="{{ path('admin.events.edit', {id:nextEvent.id }) }}" class="underlined-link">{{ heading }}</a>
            {% else %}
                {{ heading }}
            {% endif %}
        </h2>
        <ul class="next-event-infos">
            <li>
                <b>Titre :</b> {{ nextEvent.title | default('Pas d\'évènement prévu') }}
            </li>
            <li>
                <b>Date :</b> {{ nextEvent.date | default('--/--/--') }}
            </li>
            <li>
                <b>Heure :</b> {{ soiree.waltzTime | default('--:--') }} (valse) et {{ soiree.rockTime | default('--:--') }} (rock)
            </li>
            <li>
                <b>Lieu :</b> {{ soiree.place | default('---') }}
            </li>
            <li>
                <b>Prix :</b> {% if soiree.prices|default(null) %}{{ soiree.prices.online }}&nbsp;€ inscrit, {{ soiree.prices.door }}&nbsp;€ sur place{% else %}--&nbsp;€{% endif %}
            </li>
            {% if nextEvent %}
            <li>
                <b>Inscriptions :</b>
                {% if registration.status == 'open' %}
                    ouvertes, {{ registration.until }}
                {% elseif registration.status == 'upcoming' %}
                    s'ouvrent toutes seules le {{ registration.opens|dayTimeLabel }}
                {% elseif registration.status == 'cancelled' %}
                    soirée annulée
                {% else %}
                    fermées
                {% endif %}
            </li>
            {% endif %}
            {% if nextEvent.facebookLink %}
            <li>
                <b><a href="{{ nextEvent.facebookLink | default('#') }}" target="_blank" class="underlined-link">Lien vers l'évènement facebook<span class="sr-only"> (nouvel onglet)</span></a></b>
            </li>
            {% endif %}
        </ul>
        <div class="dashboard-next-actions">
            <span class="dashboard-next-count"><b>{{ nextEvent.participantsCount | default(0) }}</b> participants</span>
            {% if nextEvent.id is not defined %}
                <span class="dashboard-pill dashboard-pill-outline disabled" aria-disabled="true"><i class="mdi mdi-lock-open" aria-hidden="true"></i>Inscriptions</span>
            {% elseif nextEvent.closed == 1 %}
                {#- Forms, not links: a link from another site could change them (CsrfMiddleware only checks POST) #}
                <form action="{{ path('admin.events.open', {id:nextEvent.id}) }}" method="post" class="dashboard-pill-form">
                    <button type="submit" class="dashboard-pill dashboard-pill-outline tooltipped"
                       data-tooltip="Réouvrir les inscriptions" data-position="top"
                       aria-label="Inscriptions fermées : les réouvrir">
                        <i class="mdi mdi-lock" aria-hidden="true"></i>Fermées
                    </button>
                </form>
            {% else %}
                <form action="{{ path('admin.events.close', {id:nextEvent.id}) }}" method="post" class="dashboard-pill-form">
                    <button type="submit" class="dashboard-pill dashboard-pill-outline tooltipped"
                       data-tooltip="Clôturer les inscriptions<br>(vous serez redirigé vers la liste)" data-position="top"
                       aria-label="Inscriptions ouvertes : les clôturer (vous serez redirigé vers la liste)">
                        <i class="mdi mdi-lock-open" aria-hidden="true"></i>Ouvertes
                    </button>
                </form>
            {% endif %}
            <a class="dashboard-pill{{ nextEvent.id is defined ? '' : ' disabled' }}"
               {% if nextEvent.id is defined %}
               href="{{ path('admin.events.participants', {id:nextEvent.id}) }}"
               {% else %}
               role="link" aria-disabled="true"
               {% endif %}
            >
                <i class="mdi mdi-format-list-bulleted" aria-hidden="true"></i>Liste
            </a>
        </div>
    </section>
</div>

<script nonce="{{ csp_nonce }}" src="{{ cdn('chart.js', 'dist/chart.umd.min.js') }}"></script>
<script nonce="{{ csp_nonce }}">
    // Text and grid in the colors of the admin's theme (admin-dark.css), and again when its button switches it
    var colors = function (dark) {
        return {text: dark ? '#9aa7b4' : '#52606d', line: dark ? '#2d3640' : '#e3e8ef'};
    };
    var theme = colors(document.documentElement.getAttribute('data-theme') === 'dark');
    Chart.defaults.color = theme.text;
    Chart.defaults.font.family = "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
    var chart = new Chart(document.getElementById("dancersChart"), {
        type: 'bar',
        data: {
            // A single group of bars, one per event, without a name under it
            labels: [''],
            datasets: [
                {% for event in countForChart %}
                {
                    // Those who came without signing up, at the bottom in a darker shade
                    label: "{{ event.title | e('js') }}",
                    walkIns: true,
                    url: "{{ path('admin.events.statistics', {id: event.id}) | e('js') }}",
                    stack: "{{ event.id }}",
                    total: {{ event.count }},
                    data: [{{ event.improvised }}],
                    backgroundColor: '{{ event.shade }}'
                },
                {
                    label: "{{ event.title | e('js') }}",
                    url: "{{ path('admin.events.statistics', {id: event.id}) | e('js') }}",
                    stack: "{{ event.id }}",
                    total: {{ event.count }},
                    data: [{{ event.count - event.improvised }}],
                    backgroundColor: '{{ event.color }}'
                },
                {% endfor %}
            ]
        },
        options: {
            maintainAspectRatio: false,
            // A bar opens its event's statistics
            onClick: function (e, bars, chart) {
                if (bars.length) {
                    window.location.href = chart.data.datasets[bars[0].datasetIndex].url;
                }
            },
            onHover: function (e, bars) {
                e.native.target.style.cursor = bars.length ? 'pointer' : 'default';
            },
            plugins: {
                // One legend entry per event, which shows or hides its whole bar
                legend: {
                    labels: {
                        filter: function (item, data) {
                            return !data.datasets[item.datasetIndex].walkIns;
                        }
                    },
                    onClick: function (e, item, legend) {
                        var chart = legend.chart, visible = !chart.isDatasetVisible(item.datasetIndex);
                        [item.datasetIndex - 1, item.datasetIndex].forEach(function (i) {
                            chart.setDatasetVisibility(i, visible);
                        });
                        chart.update();
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function (item) {
                            var dataset = item.dataset, count = item.parsed.y;
                            var share = dataset.total ? Math.round(100 * count / dataset.total) : 0;
                            return dataset.label + ' : ' + count
                                + (dataset.walkIns ? ' sans inscription' : ' pré-inscrits') + ' (' + share + ' %)';
                        }
                    }
                }
            },
            scales: {
                x: {
                    stacked: true,
                    ticks: {color: theme.text},
                    grid: {display: false},
                    border: {color: theme.line}
                },
                y: {
                    stacked: true,
                    beginAtZero: true,
                    ticks: {color: theme.text},
                    grid: {color: theme.line},
                    border: {color: theme.line}
                }
            }
        }
    });
    document.addEventListener('admin-theme', function (event) {
        var theme = colors(event.detail === 'dark'), scales = chart.options.scales;
        chart.options.plugins.legend.labels.color = theme.text;
        scales.x.ticks.color = scales.y.ticks.color = theme.text;
        scales.x.border.color = scales.y.border.color = scales.y.grid.color = theme.line;
        chart.update();
    });
</script>