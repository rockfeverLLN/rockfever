{% extends 'layout.twig' %}

{% block title %}Calendrier des soirées - Rock Fever{% endblock %}

{% block description %}Toutes les dates des soirées Rock Fever à Louvain-la-Neuve, à ajouter à ton agenda en un clic.{% endblock %}

{% block canonical_path %}/calendrier{% endblock %}

{% block head %}
    <link rel="preload" as="image" href="{{ __DIR__ }}/images/body/bg.webp" fetchpriority="high"/>
    {% include '@main/soireesJsonLd.twig' with {soirees: semesters|reduce((all, soirees) => all|merge(soirees), [])} %}
{% endblock %}

{% block body %}
    {#- The page already shows the next soirée: the card is only for its sign-up #}
    {%- set nextSoiree %}{% include '@main/nextSoiree.twig' with {soirees: semesters|reduce((all, soirees) => all|merge(soirees), []), signUpOnly: true} %}{% endset %}
    <div class="parallax-container home-parallax-container{{ nextSoiree|trim ? '' : ' home-parallax-compact' }}">
        <div class="container">
            <div class="center">
                <h1 class="white-text home-title">Calendrier</h1>
            </div>
        </div>
        <div class="parallax">
            <img src="{{ __DIR__ }}/images/body/bg.webp" alt="" width="1412" height="796" fetchpriority="high">
        </div>
    </div>
    {{ nextSoiree }}

    {%- set first = (semesters|first)|first %}
    <div class="container calendar-page">
        <p class="calendar-intro">
            Sauf exception, les soirées ont lieu le mercredi soir au <strong>{{ place }}</strong> à Louvain-la-Neuve,
            de {{ first.start|date('H:i', false)|replace({':': 'h'}) }} à {{ first.end|date('H:i', false)|replace({':': 'h'}) }}.
            Elles sont ouvertes aux 18-35 ans, avec ta carte d'identité.
            Inscris-toi à l'avance sur le site pour payer {{ prices.online }}&nbsp;€ au lieu de {{ prices.door }}&nbsp;€ à l'entrée.
        </p>

        <div class="calendar-subscribe">
            <a href="webcal://rockfever.be{{ path('calendar.ics') }}" class="btn koamaru waves-effect waves-light">
                <i class="mdi mdi-calendar-multiple left" aria-hidden="true"></i>Ajouter toutes les dates
            </a>
            <a href="https://calendar.google.com/calendar/render?cid={{ ('webcal://rockfever.be' ~ path('calendar.ics'))|url_encode }}" class="btn-flat calendar-google" target="_blank" rel="noopener">
                <i class="mdi mdi-google left" aria-hidden="true"></i>Google Agenda
            </a>
            <p class="calendar-hint">Ton agenda se mettra à jour tout seul quand on ajoute des dates.</p>
        </div>

        {% for semester, soirees in semesters %}
            <h2 class="calendar-semester">{{ semester }}</h2>
            <ol class="soirees">
                {% for soiree in soirees %}
                    {% include '@main/soiree.twig' %}
                {% endfor %}
            </ol>
        {% endfor %}

        {% if nextSemester %}
            <h2 class="calendar-semester">{{ nextSemester }}</h2>
            <div class="soirees-soon">
                <i class="mdi mdi-calendar-multiple" aria-hidden="true"></i>
                <p>
                    <strong>Les dates arrivent bientôt !</strong>
                    Les soirées du prochain quadrimestre seront annoncées ici. Si tu as ajouté toutes les dates à ton agenda, elles y apparaîtront toutes seules.
                </p>
            </div>
        {% endif %}
    </div>
{% endblock %}
