<form action="{{ path('music') }}" method="post">
    {{ csrfInput() }}
    <input type="text" name="title" placeholder="Titre de la musique" class="register-input">
    <input type="text" name="artist" placeholder="Artiste" class="register-input">
    <br>
    <button class="send-button disabled">
        Envoyer la musique
        <i class="mdi mdi-send right"></i>
    </button>
</form>
