{% extends 'layout.twig' %}

{% block title %}Accueil - Rock Fever{% endblock %}

{% block canonical_path %}/{% endblock %}

{% block head %}
    <link rel="preload" as="image" href="{{ __DIR__ }}/images/body/bg.webp" fetchpriority="high"/>
    {% include '@main/soireesJsonLd.twig' %}
{% endblock %}

{% block body %}
    {%- set hasNextEvent = nextEventExist() %}
    <div class="parallax-container home-parallax-container{{ hasNextEvent ? '' : ' home-parallax-compact' }}">
        <div class="container">
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
            </div>
        </div>
        <div class="parallax">
            <img src="{{ __DIR__ }}/images/body/bg.webp" alt="People dancing rock" width="1412" height="796" fetchpriority="high">
        </div>
    </div>
    {% if hasNextEvent %}
    <a href="{{ path('event') }}" class="next-event-link koamaru">
        Inscris-toi à notre prochain événement !
    </a>
    {% endif %}

    <div class="container home-content">
        {% include 'flash.twig' %}
        {% for item in items %}
            <section class="home-section rich-text">
                <h2>{{ item.title }}</h2>
                <div>{{ item.content | lazyImages | raw }}</div>
            </section>
        {% endfor %}
        {% if members %}
            <div class="staff-grid">
                {% for member in members %}
                    <section class="staff-card rich-text">
                        <h3>{{ member.title }}</h3>
                        <div class="staff-card-content">{{ member.content | withoutEmptyParagraphs | lazyImages | raw }}</div>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}