{% extends 'layout.twig' %}

{% block title %}Accueil - Rock Fever{% endblock %}

{% block body %}
    <div class="parallax-container home-parallax-container">
        <div class="container">
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
            </div>
        </div>
        <div class="parallax">
            <img src="{{ __DIR__ }}/images/body/bg.png" alt="People dancing rock">
        </div>
    </div>
    {% if nextEventExist() %}
    <a href="{{ path('event') }}" class="full-width-link koamaru">
        Inscris-toi à notre prochain événement !
    </a>
    {% endif %}


    <div class="container">
        {% include 'flash.twig' %}
        <div class="row">
            {% for item in items %}
                <div class="col s12">
                    <div class="row">
                        <div class="col s12">
                            <h2>{{ item.title }}</h2>
                            <p>{{ item.content | raw }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}