{% extends 'layout.twig' %}

{% block title %}Accueil - Rock Fever{% endblock %}

{% block canonical_path %}/{% endblock %}

{% block head %}
    <link rel="preload" as="image" href="{{ __DIR__ }}/images/body/bg.webp" fetchpriority="high"/>
{% endblock %}

{% block body %}
    <div class="parallax-container home-parallax-container">
        <div class="container">
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
            </div>
        </div>
        <div class="parallax">
            <img src="{{ __DIR__ }}/images/body/bg.webp" alt="People dancing rock" width="1412" height="796" fetchpriority="high">
        </div>
    </div>
    {% if nextEventExist() %}
    <a href="{{ path('event') }}" class="full-width-link koamaru">
        Inscris-toi à notre prochain événement !
    </a>
    {% endif %}


    <div class="container">
        {% include 'flash.twig' %}
        <div class="row">
            {% for item in items %}
                <div class="col s12">
                    <div class="row">
                        <div class="col s12 rich-text">
                            <h2>{{ item.title }}</h2>
                            <div>{{ item.content | lazyImages(loop.first ? 1 : 0) | raw }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}