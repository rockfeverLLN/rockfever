{% extends 'layout.twig' %}

{% block title %}Accueil - Rock Fever{% endblock %}

{% block canonical_path %}/{% endblock %}

{% block head %}
    <link rel="preload" as="image" href="{{ __DIR__ }}/images/body/bg.jxl" type="image/jxl" fetchpriority="high"/>
    {% include '@main/soireesJsonLd.twig' %}
{% endblock %}

{% block body %}
    {%- set nextSoiree %}{% include '@main/nextSoiree.twig' %}{% endset %}
    <div class="parallax-container home-parallax-container{{ nextSoiree|trim ? '' : ' home-parallax-compact' }}">
        <div class="container">
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
            </div>
        </div>
        <div class="parallax">
            <picture><source srcset="{{ __DIR__ }}/images/body/bg.jxl" type="image/jxl"><img src="{{ __DIR__ }}/images/body/bg.webp" alt="People dancing rock" width="1412" height="793" fetchpriority="high"></picture>
        </div>
    </div>
    {{ nextSoiree }}

    <div class="container home-content">
        {% include 'flash.twig' %}
        {% for item in items %}
            <section class="home-section rich-text">
                <h2>{{ item.title | e | typography }}</h2>
                <div>{{ item.content | lazyImages | typography }}</div>
            </section>
        {% endfor %}
        {% if members %}
            <div class="staff-grid">
                {% for member in members %}
                    <section class="staff-card rich-text">
                        <h3>{{ member.title | e | typography }}</h3>
                        <div class="staff-card-content">{{ member.content | withoutEmptyParagraphs | lazyImages(0, '(max-width: 600px) 76px, (max-width: 992px) 43vw, 300px') | typography }}</div>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
        <section class="home-section home-press rich-text">
            <h2>Dans la presse</h2>
            <ul class="press-list">
                <li>
                    RTBF, <cite>Le 6-8</cite>
                    <time datetime="2026-07-13">13 juillet 2026</time>
                </li>
            </ul>
        </section>
    </div>
{% endblock %}