{#- The soirées of the quadrimestre under way, in place of "[dates]" in a section of the home page (HomeAction): the same
    cards as /calendrier, so a soirée that's over shows as past and the next one stands out with its sign-up.
    A quadrimestre whose soirées are all over is left out. Takes semesters, nextSemester, place #}
{%- set current = semesters|filter(soirees => soirees|filter(s => not s.past)|length > 0) %}
<div class="home-soirees">
{%- for semester, soirees in current %}
    <h3>{{ semester }}</h3>
    <ol class="soirees">
        {%- for soiree in soirees %}
            {% include '@main/soiree.twig' with {heading: 'h4', actions: soiree.next} %}
        {%- endfor %}
    </ol>
{%- else %}
    <p><strong>Les prochaines dates arrivent bientôt&#8239;!</strong>{% if nextSemester %} Les soirées de {{ nextSemester|lower }} seront annoncées ici.{% endif %}</p>
{%- endfor %}
    <p><a href="{{ path('calendar') }}">Toutes les dates à ajouter à ton agenda</a></p>
</div>
