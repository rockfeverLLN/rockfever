{% extends "layout.twig" %}

{% block title %}Prochain événement - Rock Fever{% endblock %}

{% block canonical_path %}/event{% endblock %}

{% block head %}
    {#- Schema.org event so search engines and assistants can show the date and place #}
    {%- set day = event.date|split('/') %}
    {%- set time = event.waltzTime ?: event.rockTime %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'DanceEvent',
        name: event.title,
        description: event.description,
        startDate: day[2] ~ '-' ~ day[1] ~ '-' ~ day[0] ~ (time ? 'T' ~ time : ''),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: {
            '@type': 'Place',
            name: event.place,
            address: {'@type': 'PostalAddress', addressLocality: 'Louvain-la-Neuve', addressCountry: 'BE'}
        },
        organizer: {'@type': 'Organization', '@id': 'https://rockfever.be/#organization', name: 'Rock Fever', url: 'https://rockfever.be/'},
        url: 'https://rockfever.be/event'
    }|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block bodyColor %}deep-blue{% endblock %}

{% block body %}

    <div class="parallax-container form-parallax-container{{ event.closed == 1 ? ' form-parallax-closed' }}">
        <div class="container">
            {% include 'flash.twig' %}
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
                <div class="call-to-action">
                    {% if event.closed == 0 %}
                        Inscris-toi à la prochaine soirée et paie 3&nbsp;€ au lieu de 4&nbsp;€ à l’entrée&nbsp;:
                    {% else %}
                        Les inscriptions à la prochaine soirée sont fermées. <br>Tu peux toujours venir et payer sur place&#8239;!
                    {% endif %}
                </div>
                {% if event.closed == 0 %}
                    {% include "@main/registerForm.twig" %}
                {% endif %}
            </div>
        </div>
        <div class="parallax">
            <img src="images/body/bg.webp" alt="People dancing rock">
        </div>
    </div>




    <div class="container center white-text event-details">
        <h2>«&nbsp;{{ event.title | e | typography }}&nbsp;»</h2>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-calendar" aria-hidden="true"></i> {{ event.date | dateToText }}
            </nobr>
        </span>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-clock" aria-hidden="true"></i> {{ event.waltzTime }} (valse)
            </nobr>
        </span>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-clock" aria-hidden="true"></i> {{ event.rockTime }} (rock)
            </nobr>
        </span>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-map-marker" aria-hidden="true"></i> {{ event.place }}
            </nobr>
        </span>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-credit-card" aria-hidden="true"></i> {{ event.price }}
            </nobr>
        </span>
        <br>
        <span class="event-reminder">
            N’oublie pas ta carte d’étudiant ou d’identité.
        </span>
        <br>
        <strong class="event-description-label">Description&nbsp;:</strong>
        <p>{{ event.description | e | typography | nl2br }}</p>
        <br>
    </div>

    <div class="event-links">
    {% if event.coveventLink %}
        <a href="{{ event.facebookLink }}" class="event-link blue darken-4" target="_blank">Événement Facebook</a>
        <a href="{{ event.coveventLink }}" class="event-link red darken-3" target="_blank">Covevent</a>
    {% else %}
        {% if event.facebookLink %}
            <a href="{{ event.facebookLink }}" class="event-link blue darken-4" target="_blank">Événement Facebook</a>
        {% else %}
            <a href="https://www.facebook.com/rockfeverlln/" class="event-link blue darken-4" target="_blank">Notre page Facebook</a>
        {% endif %}
    {% endif %}
    </div>

    <div id="nextEventInfos" class="modal">
        <div class="modal-footer">
            {% if event.coveventLink %}
                <a href="{{ event.coveventLink }}" class="modal-action waves-effect btn red darken-4" target="_blank">Covevent</a>
            {% endif %}
            <a href="{{ event.facebookLink }}" class="modal-action waves-effect btn blue darken-4" target="_blank">Événement Facebook</a>
        </div>
    </div>
{% endblock %}