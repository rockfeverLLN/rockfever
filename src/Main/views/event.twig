{% extends "layout.twig" %}

{% block title %}Prochain événement - Rock Fever{% endblock %}

{% block canonical_path %}/event{% endblock %}

{% block head %}
    {#- Schema.org event so search engines and assistants can show the date, place, prices and sign-up #}
    {{ soireesJsonLd([soiree]) }}
{% endblock %}

{% block bodyColor %}deep-blue{% endblock %}

{% block body %}

    {#- The next soirée (Calendar::getNext): its sign-up opens on its own the days of the settings before, once its event
        exists in the admin, can be closed there, and closes as the settings say (registration.until). The form is only there while it's open #}
    {%- set status = soiree.registration.status %}
    {%- set open = status == 'open' %}
    <div class="parallax-container form-parallax-container event-parallax{{ open ? '' : ' form-parallax-closed' }}">
        <div class="container">
            {#- After a sign-up, the popup below says it's done: the green message only without JavaScript, which opens it #}
            {% if flash('event') == 'sign_up' %}
                <noscript>{% include 'flash.twig' %}</noscript>
            {% else %}
                {% include 'flash.twig' %}
            {% endif %}
            <div class="center">
                <h1 class="white-text home-title">Rock Fever</h1>
                <h2 class="white-text event-title">{% if soiree.title %}«&nbsp;{{ soiree.title | e | typography }}&nbsp;»{% else %}{{ soiree.name }}{% endif %}</h2>
                <p class="call-to-action" id="inscriptions" data-registration-status="{{ status }}">
                    {% if open %}
                        Inscris-toi à la soirée du {{ soiree.label|lower }} et paie {{ soiree.prices.online }}&nbsp;€ au lieu de {{ soiree.prices.door }}&nbsp;€ à l’entrée&nbsp;:
                        <br><small>{{ soiree.registration.until|capitalize }}{% if soiree.registration.closes == soiree.start %}, à&nbsp;{{ soiree.start|date('H:i', false)|replace({':': 'h'}) }}{% endif %}. Il suffit de ton prénom et de ton nom.</small>
                    {% elseif status == 'upcoming' or status == 'pending' %}
                        Les inscriptions ne sont pas encore ouvertes, mais voici la prochaine soirée&#8239;!
                        <br>{% include '@main/registration.twig' %}
                    {% elseif status == 'cancelled' %}
                        La soirée du {{ soiree.label|lower }} est annulée.
                    {% else %}
                        Les inscriptions à la prochaine soirée sont fermées. <br>Tu peux toujours venir et payer sur place&#8239;!
                    {% endif %}
                </p>
                {% if open %}
                    {% include "@main/registerForm.twig" %}
                {% endif %}
            </div>
        </div>
        <div class="parallax">
            <picture><source srcset="images/body/bg.jxl" type="image/jxl"><img src="images/body/bg.webp" alt="People dancing rock"></picture>
        </div>
    </div>

    {%- set time = soiree.start|date('H:i', false)|replace({':': 'h'}) %}
    <div class="container center white-text event-details">
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-calendar" aria-hidden="true"></i> <time datetime="{{ soiree.start|date('c', false) }}">{{ soiree.label }} {{ soiree.year }}</time>
            </nobr>
        </span>
        {% if soiree.waltzTime or soiree.rockTime %}
            {% if soiree.waltzTime %}
            <span class="spaced-item">
                <nobr>
                    <i class="mdi mdi-clock" aria-hidden="true"></i> {{ soiree.waltzTime|replace({':': 'h'}) }} (valse)
                </nobr>
            </span>
            {% endif %}
            {% if soiree.rockTime %}
            <span class="spaced-item">
                <nobr>
                    <i class="mdi mdi-clock" aria-hidden="true"></i> {{ soiree.rockTime|replace({':': 'h'}) }} (rock)
                </nobr>
            </span>
            {% endif %}
        {% else %}
            <span class="spaced-item">
                <nobr>
                    <i class="mdi mdi-clock" aria-hidden="true"></i> {{ time }} – {{ soiree.end|date('H:i', false)|replace({':': 'h'}) }}
                </nobr>
            </span>
        {% endif %}
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-map-marker" aria-hidden="true"></i> {{ soiree.place }}
            </nobr>
        </span>
        <span class="spaced-item">
            <nobr>
                <i class="mdi mdi-credit-card" aria-hidden="true"></i>
                {%- if soiree.prices %} {{ soiree.prices.online }}&nbsp;€ en t’inscrivant, {{ soiree.prices.door }}&nbsp;€ sur place{% else %} {{ soiree.priceText }}{% endif %}
            </nobr>
        </span>
        <br>
        <span class="event-reminder">
            N’oublie pas ta carte d’étudiant ou d’identité.
        </span>
        <br>
        {% if soiree.description %}
            <strong class="event-description-label">Description&nbsp;:</strong>
            <p>{{ soiree.description | e | typography | nl2br }}</p>
        {% endif %}
        <p><a href="{{ soiree.url }}" class="underlined-link white-text">Page de la soirée</a> · <a href="{{ path('calendar.event', {date: soiree.date}) }}" class="underlined-link white-text">Ajouter à mon calendrier</a></p>
    </div>

    <div class="event-links">
    {% if soiree.facebookLink %}
        <a href="{{ soiree.facebookLink }}" class="event-link blue darken-4" target="_blank">Événement Facebook</a>
    {% else %}
        <a href="{{ setting('FACEBOOK_URL') }}" class="event-link blue darken-4" target="_blank">Notre page Facebook</a>
    {% endif %}
    </div>

    {#- Right after a sign-up (EventAction queues the sign_up event, bots don't get it): a popup to put the soirée in
        their calendar, so they don't forget it. script.js opens it (data-open-on-load), and its links close it #}
    {% if flash('event') == 'sign_up' %}
        <dialog id="signupCalendar" class="modal signup-calendar" data-open-on-load>
            <div class="modal-content">
                <button type="button" class="modal-close signup-calendar-x" aria-label="Fermer">
                    <i class="mdi mdi-close" aria-hidden="true"></i>
                </button>
                <i class="mdi mdi-calendar-plus signup-calendar-icon" aria-hidden="true"></i>
                <h2>C’est noté&#8239;!</h2>
                <p>Tu es sur la liste de la soirée du <strong>{{ soiree.label|lower }}</strong>, à {{ time }} au {{ soiree.place }}.
                    {%- if soiree.prices %} Tu paieras {{ soiree.prices.online }}&nbsp;€ à l’entrée.{% endif %}</p>
                <p>Ajoute-la à ton calendrier pour ne pas l’oublier&nbsp;:</p>
                <div class="soiree-actions">
                    <a href="{{ path('calendar.event', {date: soiree.date}) }}" class="btn koamaru waves-effect waves-light" autofocus
                       data-close-modal>
                        <i class="mdi mdi-calendar-plus left" aria-hidden="true"></i>Ajouter à mon calendrier
                    </a>
                    <a href="{{ soiree.googleUrl }}" class="btn-flat calendar-google" target="_blank" rel="noopener"
                       data-close-modal>
                        <i class="mdi mdi-google left" aria-hidden="true"></i>Google Agenda
                    </a>
                </div>
                <p class="signup-calendar-hint">N’oublie pas ta carte d’étudiant ou d’identité.</p>
            </div>
        </dialog>
    {% endif %}

{% endblock %}