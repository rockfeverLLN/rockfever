{#- The coming soirées as schema.org events, for search engines and AI assistants. Takes soirees, place, address #}
{%- set events = [] %}
{%- for soiree in soirees %}{% if not soiree.past %}
    {%- set events = events|merge([{
        '@context': 'https://schema.org',
        '@type': 'DanceEvent',
        name: 'Soirée Rock Fever',
        startDate: soiree.start|date('c', false),
        endDate: soiree.end|date('c', false),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: {'@type': 'Place', name: place, address: address},
        organizer: {'@type': 'Organization', '@id': 'https://rockfever.be/#organization', name: 'Rock Fever', url: 'https://rockfever.be/'},
        url: 'https://rockfever.be/calendrier'
    }]) %}
{%- endif %}{% endfor %}
{%- if events %}
<script type="application/ld+json">{{ events|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{%- endif %}
