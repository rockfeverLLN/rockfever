{% extends 'layout.twig' %}

{% block title %}Proposer une musique - Rock Fever{% endblock %}

{% block canonical_path %}/music{% endblock %}

{#- A form for the dancers, linked from the menu: not a page to land on from a search #}
{% block head %}<meta name="robots" content="noindex, follow"/>{% endblock %}

{% block body %}

<div class="parallax-container form-parallax-container">
    <div class="container">
        {% include 'flash.twig' %}
        <div class="center">
            <h1 class="white-text home-title">Rock Fever</h1>
            <div class="call-to-action">
                Tu connais une musique qui n'est encore jamais passée ? Nous ne la connaissons peut-etre pas encore. Fais-la nous découvrir !
            </div>
            {% include "@main/musicForm.twig" %}
        </div>
    </div>
    <div class="parallax">
        <picture><source srcset="{{ __DIR__ }}/images/body/bg.jxl" type="image/jxl"><img src="{{ __DIR__ }}/images/body/bg.webp" alt="Blue background"></picture>
    </div>
</div>

{% endblock %}