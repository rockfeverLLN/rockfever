{#- Card under the header that features the next soirée (Calendar::getNext), and changes on its own when its sign-up
    opens (Event::REGISTRATION_DAYS before it, once the event exists in the admin) or closes. Past soirées never show here.
    Takes signUpOnly to show it only while sign-ups are open #}
{%- set soiree = nextSoiree() %}
{%- if soiree %}
    {%- set status = soiree.registration.status %}
    {%- set when = soiree.label|lower %}
    {%- set time = soiree.start|date('H:i', false) %}
    {%- set opens = soiree.registration.opens %}
{%- endif %}
{%- if soiree and status == 'open' %}
    <a href="{{ path('event') }}" class="next-event-link koamaru">Inscris-toi à la soirée du {{ when }}&#8239;!</a>
{%- elseif not soiree or signUpOnly|default(false) %}
{%- elseif status == 'closed' %}
    <a href="{{ path('event') }}" class="next-event-link koamaru">Prochaine soirée&nbsp;: {{ when }}</a>
{%- else %}
    <a href="{{ path('event') }}" class="next-event-link next-event-soon koamaru">
        <span class="next-event-text">
            <span class="next-event-note">Les inscriptions ne sont pas encore ouvertes, mais voici la prochaine soirée&nbsp;:</span>
            <span>{{ when|capitalize }} à&nbsp;{{ time|replace({':': 'h'}) }}</span>
            <span class="next-event-note">
                {%- if status == 'upcoming' %}Ouverture des inscriptions le {{ opens|dayLabel }}{% else %}Ouverture des inscriptions très bientôt{% endif -%}
            </span>
        </span>
    </a>
{%- endif %}
