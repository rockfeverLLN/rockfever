{#- Card under the header that features the next soirée (Calendar::getNext), and changes on its own when its sign-up
    opens (the days of the settings before it, once the event exists in the admin) or closes. Past soirées never show here.
    Takes signUpOnly to show it only while sign-ups are open #}
{%- set soiree = nextSoiree() %}
{%- if soiree %}
    {%- set status = soiree.registration.status %}
    {#- On its day, "ce soir" instead of its date #}
    {%- set when = soiree.tonight ? 'ce soir' : soiree.label|lower %}
    {%- set time = soiree.start|date('H:i', false) %}
    {%- set opens = soiree.registration.opens %}
{%- endif %}
{%- if soiree and status == 'open' %}
    {#- The whole card opens the sign-up page, and its big button says so #}
    <a href="{{ path('event') }}" class="next-event-link next-event-open koamaru">
        <span class="next-event-text">
            <span class="next-event-note">Les inscriptions sont ouvertes pour {{ soiree.tonight ? 'la soirée de ce soir' : 'la prochaine soirée' }}&nbsp;:</span>
            {%- if soiree.title %}
            <span>«&nbsp;{{ soiree.title|e|typography }}&nbsp;»</span>
            {%- endif %}
            <span>{{ when|capitalize }} à&nbsp;{{ time|replace({':': 'h'}) }}</span>
            <span class="next-event-signup">Je m'inscris</span>
        </span>
    </a>
{%- elseif not soiree or signUpOnly|default(false) %}
{%- elseif status == 'closed' and soiree.tonight %}
    <a href="{{ path('event') }}" class="next-event-link koamaru">C’est ce soir à&nbsp;{{ time|replace({':': 'h'}) }}&nbsp;!</a>
{%- elseif status == 'closed' %}
    <a href="{{ path('event') }}" class="next-event-link koamaru">Prochaine soirée&nbsp;: {{ when }}</a>
{%- else %}
    {#- The whole card still opens /event through its first link, and its "add to my calendar" buttons sit over it #}
    <div class="next-event-link next-event-soon koamaru">
        <span class="next-event-text">
            <a href="{{ path('event') }}" class="next-event-main">
                <span class="next-event-note">Les inscriptions ne sont pas encore ouvertes, mais voici la prochaine soirée&nbsp;:</span>
                <span>{{ when|capitalize }} à&nbsp;{{ time|replace({':': 'h'}) }}</span>
            </a>
            <span class="next-event-note">
                {%- if status == 'upcoming' %}Ouverture des inscriptions le {{ opens|dayLabel }}{% else %}Ouverture des inscriptions très bientôt{% endif -%}
            </span>
            <span class="next-event-actions">
                <a href="{{ path('calendar.event', {date: soiree.date}) }}" class="next-event-calendar">
                    <i class="mdi mdi-calendar-plus" aria-hidden="true"></i>Ajouter à mon calendrier
                </a>
                <a href="{{ soiree.googleUrl }}" class="next-event-calendar next-event-google" target="_blank" rel="noopener">
                    <i class="mdi mdi-google" aria-hidden="true"></i>Google Agenda
                </a>
            </span>
        </span>
    </div>
{%- endif %}
