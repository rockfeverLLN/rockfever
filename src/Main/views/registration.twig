{#- Where the sign-up of a soirée stands, in one sentence (Calendar: registration.status). Takes soiree, and link to
    make "inscris-toi" a link to /event while they're open #}
{%- set registration = soiree.registration %}
{%- set opens = registration.opens %}
{%- set closes = registration.closes|date('H:i', false)|replace({':': 'h'}) %}
{%- if registration.status == 'open' -%}
    Inscriptions ouvertes jusqu’au {{ registration.closes|dayLabel }} à&nbsp;{{ closes }}&nbsp;:
    {% if link|default(false) %}<a href="{{ path('event') }}">inscris-toi</a>{% else %}inscris-toi{% endif %}
    pour payer {{ soiree.prices.online }}&nbsp;€ au lieu de {{ soiree.prices.door }}&nbsp;€ à l’entrée.
{%- elseif registration.status == 'upcoming' -%}
    Inscriptions sur le site dès le {{ opens|dayTimeLabel }}, {{ registration.until }}.
{%- elseif registration.status == 'pending' -%}
    Les inscriptions sur le site ouvrent très bientôt.
{%- elseif registration.status == 'cancelled' -%}
    Cette soirée est annulée.
{%- elseif not soiree.past -%}
    Les inscriptions sur le site sont fermées{% if soiree.prices %}&nbsp;: tu peux toujours venir et payer {{ soiree.prices.door }}&nbsp;€ sur place{% endif %}.
{%- endif -%}
