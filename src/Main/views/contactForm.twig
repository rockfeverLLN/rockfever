<form action="{{ path('contact') }}" method="post">
    <div class="row">
        <div class="col s12 m6">
            {{ field('name', item.name, 'Ton nom', {attributes: {autocomplete: 'name', required: true}}) }}
        </div>
        <div class="col s12 m6">
            {{ field('email', item.email, 'Ton adresse email', {type: 'email', attributes: {autocomplete: 'email', required: true}}) }}
        </div>
        <div class="col s12">
            {{ field('content', item.content, 'Contenu du message', {type:'textarea', attributes: {required: true}}) }}
            <button class="btn koamaru right waves-effect waves-light">Envoyer <i class="mdi mdi-send right" aria-hidden="true"></i></button>
        </div>
    </div>
</form>