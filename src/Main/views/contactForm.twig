<form action="{{ path('contact') }}" method="post">
    <div class="row">
        <div class="col s12 m6">
            {{ field('name', item.name, 'Ton nom') }}
        </div>
        <div class="col s12 m6">
            {{ field('email', item.email, 'Ton adresse email') }}
        </div>
        <div class="col s12">
            {{ field('content', item.content, 'Contenu du message', {type:'textarea'}) }}
            <button class="btn koamaru right waves-effect waves-light">Envoyer <i class="mdi mdi-send right" aria-hidden="true"></i></button>
        </div>
    </div>
</form>