{% extends '@admin/layout.twig' %}
{% block title %}A propos - Rock Fever{% endblock %}
{% block body %}
    <div class="container">
        <h1>Sections « À propos »</h1>
        <table class="striped">
            <col width="64px">
            <col>
            <col>
            <col width="200px">
            {#- Headers for screen readers only: the table reads well enough on screen without them #}
            <thead class="sr-only">
            <tr>
                <th scope="col">Position</th>
                <th scope="col">Titre</th>
                <th scope="col">Contenu</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for section in items %}
                <tr>
                    <td class="reordering-cell">
                        <form style="display: inline" action="{{ path(routePrefix ~ '.moveup',{id: section.id}) }}" method="post">
                            <button type="submit" name="moveup" class="btn-flat {% if loop.first %}waves-effect disabled{% endif %}"
                                    aria-label="Monter la section {{ section.title }}" {% if loop.first %}disabled{% endif %}>
                                <i class="mdi mdi-chevron-up" aria-hidden="true"></i>
                            </button>
                        </form>
                        <form style="display: inline" action="{{ path(routePrefix ~ '.movedown',{id: section.id}) }}" method="post">
                            <button type="submit" name="movedown" class="btn-flat {% if loop.last %}waves-effect disabled{% endif %}"
                                    aria-label="Descendre la section {{ section.title }}" {% if loop.last %}disabled{% endif %}>
                                <i class="mdi mdi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </form>
                    </td>
                    <td>{{ section.title }}</td>
                    <td>{{ section.content | excerpt(200) | raw }}</td>
                    <td>
                        <a href="{{ path(routePrefix ~ '.edit', {id: section.id}) }}" class="green-text text-lighten-1 tooltipped about-button" data-position="top" data-tooltip="Modifier la section" aria-label="Modifier la section {{ section.title }}">
                            <i class="mdi mdi-pencil" aria-hidden="true"></i>
                        </a>
                        <form style="display: inline" action="{{ path(routePrefix ~ '.delete',{id: section.id}) }}" method="post" data-confirm="Etes-vous sûr de vouloir supprimer cette section ?">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="red-text text-lighten-1 tooltipped about-button" data-position="top" data-tooltip="Supprimer la section" aria-label="Supprimer la section {{ section.title }}">
                                <i class="mdi mdi-delete" aria-hidden="true"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {{ paginate(items, routePrefix ~ '.index') }}
    </div>

    <div class="fixed-action-btn">
        <a href="{{ path('admin.about.create') }}" class="btn-floating btn-large koamaru" aria-label="Nouvelle section" title="Nouvelle section">
            <i class="mdi mdi-plus" aria-hidden="true"></i>
        </a>
    </div>
{% endblock %}