{% extends 'galleryLayout.twig' %}

{% block body %}
    <div class="container">
        <div class="row grid">
            {% for image in images %}
                <div class="col s6">
                    <div class="card">
                        <div class="card-image">
                            <img src="{{ __DIR__ }}/images/about/{{ image }}">
                            <a class="btn-floating halfway-fab waves-effect waves-light red to-clipboard" data-clipboard-text="{{ __DIR__ }}/images/about/{{ image }}">
                                <i class="material-icons">content_copy</i>
                            </a>
                        </div>
                        <div class="card-content">
                            <input type="text" value="{{ __DIR__ }}/images/about/{{ image }}">
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="fixed-action-btn">
        <a href="#upload-modal" class="btn-floating btn-large koamaru modal-trigger">
            <i class="mdi mdi-plus"></i>
        </a>
    </div>

    <div id="upload-modal" class="modal modal-fixed-footer">
        <form action="{{ path('admin.about.gallery') }}" method="post" enctype="multipart/form-data">
            <div class="modal-content">
                <h4>Ajouter une image</h4>
                <div class="file-field input-field">
                    <div class="btn">
                        <span>Image</span>
                        <input type="file" name="image">
                    </div>
                    <div class="file-path-wrapper">
                        <input class="file-path validate" type="text">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="#!" class="modal-close waves-effect waves-red red-text btn-flat">Annuler</a>
                <button type="submit" class="modal-close waves-effect waves-green btn green">Uploader</button>
            </div>
        </form>
    </div>
{% endblock %}