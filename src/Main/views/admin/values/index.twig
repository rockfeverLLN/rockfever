{% extends '@admin/layout.twig' %}
{% block title %}Paramètres - Rock Fever{% endblock %}
{% block body %}
    <div class="container">
        <h1>Valeurs par défaut</h1>
        <table class="striped">
            <thead>
            <tr>
                <th>Label</th>
                <th>Nom</th>
                <th>Valeur</th>
                <th style="width: 150px"></th>
            </tr>
            </thead>
            <tbody>
            {% for value in values %}
                <tr>
                    <td>{{ value.label }}</td>
                    <td>{{ value.name }}</td>
                    <td>{{ value.value | excerpt(40) | raw }}</td>
                    <td>
                        <a class="waves-effect waves-koamaru btn-flat modal-trigger koamaru-text" href="#modal_{{ value.id }}"><i class="material-icons left">edit</i> Modifier</a>
                    </td>

                    <div id="modal_{{ value.id }}" class="modal modal-fixed-footer">
                        <form method="post">
                            <div class="modal-content">
                                <h4>
                                    {{ value.label }}
                                    <div class="chip right" style="margin-top: 8px">
                                        <img src="{{ __DIR__ }}/images/body/text.png" alt="Contact Person">
                                        Valeur : <strong>{{ value.value | excerpt(30) | raw }}</strong>
                                    </div>
                                </h4>
                                <br>
                                {% if value.type == 'string' %}
                                    {{ field('value', value.value, 'Nouvelle valeur', {idSuffix:value.id}) }}
                                {% elseif value.type == 'text' %}
                                    {{ field('value', value.value, '', {idSuffix:value.id, type:'textarea'}) }}
                                {% elseif value.type == 'html' %}
                                    {{ field('value', value.value, '', {idSuffix:value.id, type:'tinymce'}) }}
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <a href="#!" class="modal-close waves-effect waves-red btn-flat red-text">Annuler</a>
                                <button type="submit" class="modal-close waves-effect waves-green green-text btn-flat">Modifier</button>
                                <input type="hidden" name="id" value="{{ value.id }}">
                            </div>
                        </form>
                    </div>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}