{% extends '@admin/layout.twig' %}
{% block title %}Réglages - Rock Fever{% endblock %}
{% block body %}
    <div class="container">
        <h1>Réglages du site</h1>
        <p class="grey-text">
            Les heures, le lieu, les prix et l'ouverture des inscriptions des soirées se règlent sur la page
            <a href="{{ path('admin.events.index') }}" class="underlined-link">Événements</a>.
        </p>
        <form method="post" class="row">
            {% for name, setting in settings %}
                <div class="col s12{{ setting.type in ['email', 'url'] ? ' m4' }}">
                    {%- if setting.type == 'html' %}
                        <h2 style="font-size: 1.5rem">{{ setting.label }}</h2>
                        {{ field(name, setting.value, setting.label, {type: 'tinymce'}) }}
                    {%- elseif setting.type == 'email' %}
                        {{ field(name, setting.value, setting.label, {type: 'email', attributes: {required: true}}) }}
                    {%- else %}
                        {{ field(name, setting.value, setting.label, {attributes: {pattern: 'https://.*'}}) }}
                    {%- endif %}
                </div>
            {% endfor %}
            <div class="col s12">
                <button class="btn koamaru right">Enregistrer les réglages</button>
            </div>
        </form>
    </div>
{% endblock %}
