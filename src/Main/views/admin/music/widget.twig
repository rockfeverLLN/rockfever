<div class="col s12">
    <section class="dashboard-card">
        <h2>Dernières musiques proposées</h2>
        {% if items.isEmpty %}
            <p class="dashboard-empty">Aucune nouvelle musique n'a été proposée</p>
        {% else %}
            <table class="dashboard-table">
                <thead>
                <tr>
                    <th>Titre</th>
                    <th>Artiste</th>
                    <th>Youtube</th>
                </tr>
                </thead>
                <tbody>
                {% for music in items %}
                    <tr>
                        <td>{{ music.title | excerpt(50) }}</td>
                        <td>{{ music.artist | excerpt(50) }}</td>
                        <td>
                            <a href="https://www.youtube.com/results?search_query={{ music.title | toSearch }}+{{ music.artist | toSearch }}" class="dashboard-play tooltipped" data-position="top" data-tooltip="Voir sur youtube" target="_blank" aria-label="Voir sur youtube">
                                <i class="mdi mdi-play" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
