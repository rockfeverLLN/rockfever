{% extends '@admin/layout.twig' %}

{% block title %}Utilisateurs - Rock Fever{% endblock %}
{% block body %}
    <div class="container">
        <h1>Utilisateurs</h1>
        <div class="row">
            {% for role in roles %}
            <div class="col s12 m6">
                <div class="card" style="border: none; box-shadow: none">
                    <div class="card-content">
                        <div class="center">
                            <img src="{{ __DIR__ }}/images/body/{{ role.role }}.svg" alt="">
                        </div>
                        <h2 class="center" style="font-size: 2rem; margin-top: 0">{{ role.label }}</h2>
                        <form action="{{ path('admin.roles.index') }}" method="post">
                            <input type="hidden" name="id" value="{{ role.id }}">
                            {{ field('label', role.label, 'Label', {idSuffix:role.id}) }}
                            {{ field('password', null, 'Nouveau mot de passe', {type:'password', idSuffix:role.id, attributes: {autocomplete: 'new-password'}}) }}
                            <div class="center-align">
                                <button class="btn koamaru waves-effect waves-light">Modifier<span class="sr-only"> {{ role.label }}</span></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}