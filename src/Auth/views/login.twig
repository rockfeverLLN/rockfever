{%  extends 'layout.twig' %}

{% block title %}Connexion - Rock Fever{% endblock %}

{% block body %}
    {#- The team's sign-in: one card in the middle of the page, with the site's colours and buttons #}
    <div class="container login-page">
        <div class="login-card">
            <h1 class="login-title">Connexion</h1>
            <p class="login-subtitle">Espace réservé à l’équipe de Rock Fever</p>
            {%- include 'flash.twig' %}
            <form action="{{ path('auth.login') }}" method="post">
                {{ field('role', null, 'Rôle', {type: 'select', options:roles }) }}
                {{ field('password', null, 'Mot de passe', {type:'password'}) }}
                <button class="login-button">Se connecter</button>
            </form>
        </div>
    </div>
{% endblock %}
