{% extends 'layout.twig' %}

{% block title %}Photos - Rock Fever{% endblock %}

{% block head %}{% include '@photos/head.twig' %}{% endblock %}

{% block bodyColor %}photos-dark{% endblock %}

{% block body %}
    <div class="photos-page">
        <header class="photos-index-header">
            <h1>Photos</h1>
            <p>Les photos de nos soirées, par quadrimestre. Tu es sur une photo et tu préfères qu'elle soit retirée ?
                Ouvre-la et choisis <strong>Demander la suppression</strong>.</p>
        </header>

        {% include '@photos/flash.twig' %}

        {% for collection, albums in collections %}
            <section class="photos-collection" id="{{ albums[0].collectionSlug }}" aria-labelledby="{{ albums[0].collectionSlug }}-title">
                <h2 id="{{ albums[0].collectionSlug }}-title">{{ collection }}</h2>
                <ul class="photos-albums">
                    {% for album in albums %}
                        <li>
                            <a href="{{ path('photos.album', {slug: album.slug}) }}">
                                <span class="photos-album-cover">
                                    <img src="{{ path('photos.file', {id: album.coverId, size: '960'}) }}" alt=""
                                         {% if loop.parent.loop.index > 1 or loop.index > 6 %}loading="lazy" {% endif %}decoding="async">
                                </span>
                                <span class="photos-album-title">{{ album.title }}</span>
                                <span class="photos-album-meta">
                                    {{ album.photoCount }} photo{{ album.photoCount > 1 ? 's' }}{% if album.photographer %} · par {{ album.photographer }}{% endif %}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <div class="photos-empty">
                <i class="mdi mdi-camera" aria-hidden="true"></i>
                <p>Pas encore de photos ici. Reviens après la prochaine soirée !</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
