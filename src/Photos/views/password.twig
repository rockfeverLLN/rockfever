{% extends 'layout.twig' %}

{% block title %}{{ album.title }} - Photos - Rock Fever{% endblock %}

{% block head %}{% include '@photos/head.twig' %}{% endblock %}

{% block bodyColor %}photos-dark{% endblock %}

{% block body %}
    <div class="photos-lock">
        <div class="photos-lock-card">
            <div class="photos-lock-icon" aria-hidden="true"><i class="mdi mdi-lock"></i></div>
            <p class="photos-lock-collection">{{ album.collection }}</p>
            <h1>{{ album.title }}</h1>
            {% if open %}
                <p>Les photos de cette soirée sont réservées à ses danseurs. Entre le mot de passe donné par l'équipe.</p>
                <form action="{{ path('photos.album', {slug: album.slug}) }}" method="post">
                    {{ csrfInput() }}
                    <label for="photos-password" class="photos-label">Mot de passe de la soirée</label>
                    <input type="password" id="photos-password" name="password" class="photos-input browser-default"
                           autocomplete="off" required autofocus
                           {% if error %}aria-invalid="true" aria-describedby="photos-password-error"{% endif %}>
                    {% if error %}
                        <p class="photos-error" id="photos-password-error" role="alert">{{ error }}</p>
                    {% endif %}
                    <button type="submit" class="photos-button photos-button-primary">Voir les photos</button>
                </form>
            {% else %}
                <p>Cet album n'est pas encore ouvert. Reviens bientôt !</p>
            {% endif %}
            <a class="photos-lock-back" href="{{ path('photos') }}">Tous les albums</a>
        </div>
    </div>
{% endblock %}
