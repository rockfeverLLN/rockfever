{% extends '@admin/layout.twig' %}

{% block title %}{{ album.title }} - Photos - Rock Fever{% endblock %}

{% block css %}{% include '@photos/admin/style.twig' %}{% endblock %}

{% block body %}
    <div class="container photos-admin">
        <p class="crumbs"><a href="{{ path('admin.photos.index') }}">Photos</a> › {{ album.collection }}</p>
        <h1>
            {{ album.title }}
            <a href="{{ path('photos.album', {slug: album.slug}) }}" target="_blank" class="btn-flat koamaru-text waves-effect">Voir l'album</a>
        </h1>

        {#- Who sees it: its password, changed in the form on the right (PhotoAccess) #}
        {% if album.password %}
            <div class="row"><div class="col s12"><div class="card-panel green lighten-5">
                <i class="mdi mdi-lock"></i> Les danseurs ouvrent cet album avec le mot de passe <b>{{ album.password }}</b>.
            </div></div></div>
        {% else %}
            <div class="row"><div class="col s12"><div class="card-panel green lighten-5">
                <i class="mdi mdi-earth"></i> <b>Tout le monde voit cet album</b> : il n'a pas de mot de passe.
            </div></div></div>
        {% endif %}

        <div class="row">
            <div class="col s12 l8">
                <div class="card-panel">
                    <h2>Ajouter des photos</h2>
                    <form action="{{ path('admin.photos.upload', {id: album.id}) }}" method="post" enctype="multipart/form-data" id="photos-upload">
                        <div class="input-field">
                            <input type="text" id="photos-section" name="section" maxlength="100" list="photos-sections" placeholder="Aucun : seulement dans « Toutes les photos »">
                            <label for="photos-section" class="active">Onglet (facultatif, par ex. « Photobooth »)</label>
                            <datalist id="photos-sections">
                                {% for name in sections %}<option value="{{ name }}">{% endfor %}
                            </datalist>
                        </div>
                        <label class="photos-drop" id="photos-drop">
                            <i class="mdi mdi-cloud-upload" aria-hidden="true"></i>
                            Glisse tes photos ici, ou clique pour les choisir
                            <br><small>JPEG, PNG ou WebP. Elles sont réduites à 2400 pixels et la position GPS est retirée.</small>
                            <input type="file" name="photos[]" accept="image/jpeg,image/png,image/webp" multiple>
                        </label>
                        <noscript><button class="btn koamaru" style="margin-top: 12px">Envoyer</button></noscript>
                        <div class="photos-progress" id="photos-progress" aria-live="polite"></div>
                    </form>
                </div>
            </div>
            <div class="col s12 l4">
                <div class="card-panel">
                    <h2>Album</h2>
                    <form action="{{ path('admin.photos.album', {id: album.id}) }}" method="post">
                        {% include '@photos/admin/album-fields.twig' with {suffix: '-edit', event: null} %}
                        <button class="btn koamaru waves-effect waves-light">Enregistrer</button>
                    </form>
                    <form action="{{ path('admin.photos.album.delete', {id: album.id}) }}" method="post" style="margin-top: 16px"
                          data-confirm="Supprimer l'album et ses {{ photos|length }} photos ? C'est définitif.">
                        <button class="btn-flat red-text waves-effect"><i class="mdi mdi-delete left"></i>Supprimer l'album</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row"><div class="col s12"><div class="card-panel">
            <h2>Photos ({{ photos|length }})</h2>
            {% if photos|length %}
                {#- The tiles' cover buttons submit this form (forms can't be nested in the delete form) #}
                <form action="{{ path('admin.photos.album.cover', {id: album.id}) }}" method="post" id="photos-cover">
                </form>
                {#- The descriptions under the photos belong to this form: each is saved as it's written (script below) #}
                <form action="{{ path('admin.photos.descriptions', {id: album.id}) }}" method="post" id="photos-descriptions">
                </form>
                {% set described = photos|filter(p => p.description)|length %}
                <p class="photos-describe-intro">
                    <b>Décris chaque photo</b> en une phrase : ce qu'elle montre, pour les personnes aveugles qui l'écoutent
                    avec un lecteur d'écran (par ex. « Deux danseurs en plein porté, la salle applaudit »).
                    Pas besoin de « Photo de… » ni des noms.
                    <span id="photos-described">{{ described }} sur {{ photos|length }} décrite{{ described > 1 ? 's' }}.</span>
                </p>
                {% set cover = album.coverPhotoId in photos|map(p => p.id) ? album.coverPhotoId : photos[0].id %}
                <form action="{{ path('admin.photos.delete') }}" method="post" id="photos-delete">
                    <input type="hidden" name="album" value="{{ album.id }}">
                    <div class="photos-toolbar">
                        <span class="count" id="photos-count">Coche des photos pour les supprimer</span>
                        <button type="button" class="btn-flat waves-effect" id="photos-all">Tout cocher</button>
                        <button class="btn red waves-effect waves-light" id="photos-delete-button" disabled><i class="mdi mdi-delete left"></i>Supprimer</button>
                    </div>
                    <div class="photos-admin-grid">
                        {% for photo in photos %}
                            <div class="photos-admin-item">
                            <div class="photos-admin-tile">
                                {#- Opens the whole photo, at its own shape (the tile crops it square). Without the script, in a new tab #}
                                <a class="open" href="{{ path('photos.file', {id: photo.id, size: '1600'}) }}" target="_blank" rel="noopener"
                                   aria-label="Voir la photo {{ loop.index }} en entier">
                                    <img src="{{ path('photos.file', {id: photo.id, size: '480'}) }}" alt="" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy">
                                </a>
                                <label>
                                    <input type="checkbox" class="filled-in" name="ids[]" value="{{ photo.id }}" aria-label="Cocher la photo {{ loop.index }}">
                                    <span></span>
                                </label>
                                {% if photo.id == cover %}
                                    <span class="cover is-cover" title="La couverture de l'album">★ Couverture</span>
                                {% else %}
                                    <button type="submit" form="photos-cover" name="photo_id" value="{{ photo.id }}"
                                            class="cover" title="En faire la couverture de l'album" aria-label="En faire la couverture de l'album">☆</button>
                                {% endif %}
                                {% if photo.id in requested %}
                                    <span class="badge-bottom requested">Suppression demandée</span>
                                {% elseif photo.section %}
                                    <span class="badge-bottom">{{ photo.section }}</span>
                                {% endif %}
                            </div>
                            <div class="photos-describe">
                                <label for="photo-description-{{ photo.id }}">
                                    Description
                                    <a href="{{ path('photos.file', {id: photo.id, size: '1600'}) }}" target="_blank" rel="noopener" aria-label="voir en grand : photo {{ loop.index }}">voir en grand</a>
                                </label>
                                <textarea id="photo-description-{{ photo.id }}" name="descriptions[{{ photo.id }}]" form="photos-descriptions"
                                          class="browser-default" rows="2" maxlength="300"
                                          aria-describedby="photo-description-status-{{ photo.id }}">{{ photo.description }}</textarea>
                                <span class="photos-describe-status" id="photo-description-status-{{ photo.id }}" aria-live="polite"></span>
                            </div>
                            </div>
                        {% endfor %}
                    </div>
                </form>
                <button type="submit" form="photos-descriptions" class="btn koamaru waves-effect waves-light photos-describe-save">Enregistrer les descriptions</button>
                <dialog class="photos-admin-viewer" id="photos-admin-viewer" aria-label="Photo en entier">
                    <div class="bar">
                        <span class="count" aria-live="polite"></span>
                        <button type="button" data-viewer="close" aria-label="Fermer"><i class="mdi mdi-close" aria-hidden="true"></i></button>
                    </div>
                    <div class="stage">
                        <button type="button" class="prev" data-viewer="prev" aria-label="Photo précédente"><i class="mdi mdi-chevron-left" aria-hidden="true"></i></button>
                        <img alt="">
                        <button type="button" class="next" data-viewer="next" aria-label="Photo suivante"><i class="mdi mdi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </dialog>
            {% else %}
                <p class="grey-text">Pas encore de photo dans cet album.</p>
            {% endif %}
        </div></div></div>
    </div>
{% endblock %}

{% block js %}
    <script nonce="{{ csp_nonce }}">
        (function () {
            // Delete: count the checked photos
            var deleteForm = document.getElementById('photos-delete');
            if (deleteForm) {
                var boxes = deleteForm.querySelectorAll('input[name="ids[]"]');
                var count = document.getElementById('photos-count');
                var button = document.getElementById('photos-delete-button');
                var update = function () {
                    var checked = deleteForm.querySelectorAll('input[name="ids[]"]:checked').length;
                    button.disabled = checked === 0;
                    count.textContent = checked ? checked + ' photo' + (checked > 1 ? 's' : '') + ' cochée' + (checked > 1 ? 's' : '') : 'Coche des photos pour les supprimer';
                };
                deleteForm.addEventListener('change', update);
                document.getElementById('photos-all').addEventListener('click', function () {
                    var all = deleteForm.querySelectorAll('input[name="ids[]"]:checked').length !== boxes.length;
                    boxes.forEach(function (box) { box.checked = all; });
                    this.textContent = all ? 'Tout décocher' : 'Tout cocher';
                    update();
                });
                deleteForm.addEventListener('submit', function (event) {
                    var checked = deleteForm.querySelectorAll('input[name="ids[]"]:checked').length;
                    if (!confirm('Supprimer définitivement ' + checked + ' photo' + (checked > 1 ? 's' : '') + ' ?')) {
                        event.preventDefault();
                    }
                });
            }

            // A photo opens whole, at its own shape, over the page: the arrows (or the arrow keys) go to the others
            var viewer = document.getElementById('photos-admin-viewer');
            var opens = document.querySelectorAll('.photos-admin-tile .open');
            if (viewer && typeof viewer.showModal === 'function') {
                var shown = viewer.querySelector('img');
                var shownCount = viewer.querySelector('.count');
                var prev = viewer.querySelector('[data-viewer="prev"]');
                var next = viewer.querySelector('[data-viewer="next"]');
                var current = 0;
                shown.addEventListener('load', function () {
                    shown.classList.remove('is-loading');
                });
                var show = function (index) {
                    current = index;
                    // The previous photo stays until this one has loaded: dimmed, so it isn't taken for it
                    if (shown.getAttribute('src') !== opens[index].href) {
                        shown.classList.add('is-loading');
                    }
                    shown.src = opens[index].href;
                    // The next ones in the other direction too, so the arrows show them at once
                    [index - 1, index + 1].forEach(function (i) {
                        if (opens[i]) {
                            new Image().src = opens[i].href;
                        }
                    });
                    shownCount.textContent = (index + 1) + ' / ' + opens.length;
                    prev.disabled = index === 0;
                    next.disabled = index === opens.length - 1;
                };
                opens.forEach(function (link, index) {
                    link.addEventListener('click', function (event) {
                        event.preventDefault();
                        show(index);
                        viewer.showModal();
                    });
                });
                viewer.addEventListener('click', function (event) {
                    var action = event.target.closest('[data-viewer]');
                    action = action && action.dataset.viewer;
                    if (action === 'prev' && current > 0) {
                        show(current - 1);
                    } else if (action === 'next' && current < opens.length - 1) {
                        show(current + 1);
                    } else if (action === 'close' || event.target.classList.contains('stage')) {
                        viewer.close();
                    }
                });
                viewer.addEventListener('keydown', function (event) {
                    if (event.key === 'ArrowLeft' && current > 0) {
                        show(current - 1);
                    } else if (event.key === 'ArrowRight' && current < opens.length - 1) {
                        show(current + 1);
                    }
                });
                // The browser gives the focus back to the photo that was opened
                viewer.addEventListener('close', function () {
                    // Unless another photo was opened before this event came
                    if (!viewer.open) {
                        shown.removeAttribute('src');
                    }
                });
            }

            // Descriptions: each one saved as soon as it's written (the button saves them all, without the script)
            var describeForm = document.getElementById('photos-descriptions');
            if (describeForm) {
                var fields = document.querySelectorAll('textarea[form="photos-descriptions"]');
                var described = document.getElementById('photos-described');
                var countDescribed = function () {
                    var n = Array.prototype.filter.call(fields, function (field) { return field.value.trim() !== ''; }).length;
                    described.textContent = n + ' sur ' + fields.length + ' décrite' + (n > 1 ? 's' : '') + '.';
                };
                fields.forEach(function (field) {
                    var status = document.getElementById(field.getAttribute('aria-describedby'));
                    field.addEventListener('change', function () {
                        var data = new FormData();
                        data.append(field.name, field.value);
                        status.className = 'photos-describe-status';
                        status.textContent = 'Enregistrement…';
                        fetch(describeForm.action, {method: 'POST', body: data, headers: {'Accept': 'application/json'}, credentials: 'same-origin'})
                            .then(function (response) {
                                if (!response.ok) {
                                    throw new Error(response.status);
                                }
                                status.textContent = 'Enregistrée';
                                countDescribed();
                            })
                            .catch(function () {
                                status.className = 'photos-describe-status is-error';
                                status.textContent = 'Pas enregistrée : réessaie avec le bouton en bas';
                            });
                    });
                    // Enter saves and goes to the next photo's description, rather than starting a new line
                    field.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter' && !event.shiftKey) {
                            event.preventDefault();
                            var next = fields[Array.prototype.indexOf.call(fields, field) + 1];
                            if (next) {
                                next.focus();
                            } else {
                                field.blur();
                            }
                        }
                    });
                });
            }

            // Upload: one photo per request, made smaller in the browser first (quicker, under the server's size
            // limit, and the canvas drops the GPS position). The server makes them smaller too, for the no-script form
            var uploadForm = document.getElementById('photos-upload');
            var drop = document.getElementById('photos-drop');
            var input = uploadForm.querySelector('input[type="file"]');
            var section = document.getElementById('photos-section');
            var progress = document.getElementById('photos-progress');
            var MAX = 2400;

            function shrink(file) {
                if (!window.createImageBitmap) {
                    return Promise.resolve(file);
                }
                return createImageBitmap(file, {imageOrientation: 'from-image'}).then(function (bitmap) {
                    var scale = Math.min(1, MAX / Math.max(bitmap.width, bitmap.height));
                    var canvas = document.createElement('canvas');
                    canvas.width = Math.round(bitmap.width * scale);
                    canvas.height = Math.round(bitmap.height * scale);
                    canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
                    return new Promise(function (resolve) {
                        canvas.toBlob(function (blob) {
                            resolve(blob ? new File([blob], file.name.replace(/\.[^.]*$/, '') + '.jpg', {type: 'image/jpeg'}) : file);
                        }, 'image/jpeg', 0.88);
                    });
                }).catch(function () {
                    // A format the browser can't read: the server says if it can't either
                    return file;
                });
            }

            function upload(files) {
                files = Array.prototype.slice.call(files);
                if (!files.length) {
                    return;
                }
                var done = 0, added = 0, errors = [];
                progress.innerHTML = '<span></span><div class="progress"><div class="determinate" style="width: 0"></div></div>';
                var label = progress.querySelector('span');
                var bar = progress.querySelector('.determinate');
                var step = function () {
                    label.textContent = 'Envoi des photos : ' + done + ' / ' + files.length;
                    bar.style.width = (100 * done / files.length) + '%';
                };
                step();
                files.reduce(function (previous, file) {
                    return previous.then(function () {
                        return shrink(file);
                    }).then(function (photo) {
                        var data = new FormData();
                        data.append('photos[]', photo, photo.name);
                        data.append('section', section.value);
                        return fetch(uploadForm.action, {method: 'POST', body: data, headers: {'Accept': 'application/json'}, credentials: 'same-origin'});
                    }).then(function (response) {
                        return response.json().catch(function () {
                            return {added: 0, errors: [file.name + ' : erreur du serveur (' + response.status + ')']};
                        });
                    }).then(function (result) {
                        added += result.added;
                        errors = errors.concat(result.errors);
                    }).catch(function () {
                        errors.push(file.name + " n'a pas pu être envoyée");
                    }).then(function () {
                        done++;
                        step();
                    });
                }, Promise.resolve()).then(function () {
                    label.textContent = added + ' photo' + (added > 1 ? 's' : '') + ' ajoutée' + (added > 1 ? 's' : '') + (errors.length ? '. Erreurs : ' + errors.join(', ') : '');
                    if (added && !errors.length) {
                        location.reload();
                    } else if (added) {
                        var reload = document.createElement('a');
                        reload.href = location.href;
                        reload.className = 'btn-flat koamaru-text';
                        reload.textContent = 'Voir les photos ajoutées';
                        progress.appendChild(reload);
                    }
                });
            }

            input.addEventListener('change', function () {
                upload(input.files);
                input.value = '';
            });
            ['dragenter', 'dragover'].forEach(function (type) {
                drop.addEventListener(type, function (event) {
                    event.preventDefault();
                    drop.classList.add('is-over');
                });
            });
            ['dragleave', 'drop'].forEach(function (type) {
                drop.addEventListener(type, function () {
                    drop.classList.remove('is-over');
                });
            });
            drop.addEventListener('drop', function (event) {
                event.preventDefault();
                upload(event.dataTransfer.files);
            });
        })();
    </script>
{% endblock %}
