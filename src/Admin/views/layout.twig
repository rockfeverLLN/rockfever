<!DOCTYPE html>
<html>
<head>
    {#- Before the stylesheets, so a dark page never shows white first: the theme chosen with the top bar's button,
        else the device's (admin-dark.css) #}
    <script nonce="{{ csp_nonce }}">
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('admin-theme'); } catch (e) {}
            if (theme !== 'dark' && theme !== 'light') {
                theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <title>{% block title %}Rock Fever{% endblock %}</title>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"/>
    <link type="text/css" rel="stylesheet" href="{{ asset('/css/base.css') }}"/>
    <link  href="{{ asset('/css/style.css') }}" rel="stylesheet"/>
    <link href="{{ asset('/css/admin-dark.css') }}" rel="stylesheet"/>

    {% block css %}{% endblock %}

    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>

<body class="{% block bodyColor %}{% endblock %}">
{% include "@admin/topbar.twig" %}

<div class="container">
    {% include 'flash.twig' %}
</div>

{% block body %}{% endblock %}

<script nonce="{{ csp_nonce }}" src="https://cdn.jsdelivr.net/npm/tinymce@8.10.1/tinymce.min.js"></script>
{% block js %}{% endblock %}
<script nonce="{{ csp_nonce }}" type="text/javascript" src="{{ asset('/js/script.js') }}"></script>
</body>
</html>