<!DOCTYPE html>
<html>
<head>
    <title>{% block title %}Rock Fever{% endblock %}</title>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"/>
    <link type="text/css" rel="stylesheet" href="{{ asset('/css/base.css') }}"/>
    <link  href="{{ asset('/css/style.css') }}" rel="stylesheet"/>

    {% block css %}{% endblock %}

    <link rel="shortcut icon" type="image/png" href="{{ __DIR__ }}/images/favicon.png"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
</head>

<body class="{% block bodyColor %}{% endblock %}">
{% include "@admin/topbar.twig" %}

<div class="container">
    {% include 'flash.twig' %}
</div>

{% block body %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/tinymce@8.10.1/tinymce.min.js"></script>
{% block js %}{% endblock %}
<script type="text/javascript" src="{{ asset('/js/script.js') }}"></script>
</body>
</html>