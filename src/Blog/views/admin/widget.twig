<div class="col-sm-4">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">{{ countPosts }}</h4>
            <p class="card-text">post{% if countPosts>1 %}s{% endif %}</p>
            <a href="{{ path('blog.admin.index') }}" class="btn btn-primary">Manage posts</a>
        </div>
    </div>
</div>
<div class="col-sm-4">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">{{ countCategories }}</h4>
            <p class="card-text">categor{% if countCategories>1 %}ies{% else %}y{% endif %}</p>
            <a href="{{ path('blog.category.admin.index') }}" class="btn btn-primary">Manage categories</a>
        </div>
    </div>
</div>