{% extends '@admin/layout.twig' %}

{% block title %}Edit posts{% endblock %}

{% block body %}
    <h1>Welcome on the blog</h1>

    <p class="text-right">
        <a href="{{ path(routePrefix ~ '.create') }}" class="btn btn-primary">
            Write a post
        </a>
    </p>
    
    <table class="table table-striped">
        <thead>
        <tr>
            <td>Title</td>
            <td>Category</td>
            <td>Actions</td>
        </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td>{{ item.name }}</td>
                    <td>{{ item.categoryName }}</td>
                    <td>
                        <a href="{{ path(routePrefix ~ '.edit', {id: item.id}) }}" class="btn btn-primary">Edit</a>
                        <form style="display: inline" action="{{ path(routePrefix ~ '.delete',{id: item.id}) }}" method="post" onsubmit="return confirm('Are you sure?')">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {{ paginate(items, routePrefix ~ '.index') }}
{% endblock %}

