{{ csrfInput() }}
<div class="row">
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-12">
                {{ field('name', item.name, 'Post\'s title') }}
            </div>
            <div class="col-md-6">
                {{ field('slug', item.slug, 'Post\'s slug') }}
            </div>
            <div class="col-md-6">
                {{ field('category_id', item.categoryId, 'Category name', {type: 'select', options: categories}) }}
            </div>
            <div class="col-md-12">
                {{ field('content', item.content, 'Post\'s content', {type: 'textarea'}) }}
            </div>
            <div class="col-md-6">
                {{ field('created_at', item.createdAt, 'Publication date', {class: 'datepicker'}) }}
            </div>
            <div class="col-md-6">
                {{ field('public', item.public, "Make public", {type: 'checkbox'}) }}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        {{ field('image', '', "Image", {type: 'file'}) }}

        {% if item.image %}
            <img src="{{ item.thumb }}" alt="{{ item.name }}" style="width: 100%">
        {% endif %}
    </div>
</div>